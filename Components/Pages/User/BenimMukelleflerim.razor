@page "/user/mukelleflerim"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using SAT242516026.Models.MyDbModels
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IMyDbModel_Provider Provider

<h3 class="mb-3">Benim Mükelleflerim</h3>

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <div class="alert alert-info">@_msg</div>
}

@if (_db is null)
{
    <div class="alert alert-info">Yükleniyor...</div>
    return;
}

<table class="table table-sm table-striped">
    <thead>
        <tr>
            <th style="width:80px;">Id</th>
            <th>Ad</th>
            <th>VergiNo</th>
            <th>Tip</th>
            <th>Telefon</th>
        </tr>
    </thead>
    <tbody>
        @if ((_db.Items?.Count ?? 0) == 0)
        {
            <tr><td colspan="5" class="text-muted text-center py-3">Kayıt yok.</td></tr>
        }
        else
        {
            @foreach (var m in _db.Items!)
            {
                <tr>
                    <td>@m.Id</td>
                    <td>@m.Ad</td>
                    <td>@(m.VergiNo ?? "-")</td>
                    <td>@(m.Tip ?? "-")</td>
                    <td>@(m.Telefon ?? "-")</td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private const string SP = "Sp_User_Mukelleflerim";

    private IMyDbModel<MukellefRow>? _db;
    private string? _msg;
    private int _uid;

    public class MukellefRow
    {
        public int Id { get; set; }
        public string Ad { get; set; } = "";
        public string? VergiNo { get; set; }
        public string? Tip { get; set; }
        public string? Telefon { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _db = Provider.Create<MukellefRow>();

        var auth = await AuthStateTask;
        var idStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        _ = int.TryParse(idStr, out _uid);

        if (_uid <= 0)
        {
            _msg = "Oturum yok. Tekrar giriş yap.";
            return;
        }

        _db.Parameters.PageNumber = 1;
        _db.Parameters.PageSize = 100;
        _db.Parameters.OrderBy = "Id desc";

        await Load();
    }

    private Task Load() => GetItems();

    private async Task GetItems()
    {
        if (_db is null) return;

        _db.Parameters.Where = new Dictionary<string, string>
            {
                ["CurrentUserId"] = _uid.ToString()
            };

        await Provider.Execute(_db, SP, isPagination: true);
        _msg = _db.Message;
    }
}
