@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@page "/user/mukelleflerim"

@using SAT242516026.Models.MyDbModels
@using Microsoft.AspNetCore.Components.Authorization
@inject IMyDbModel_Provider Provider

<h3 class="mb-3">Benim Mükelleflerim</h3>

@if (_db is null)
{
    <div class="alert alert-info">Yükleniyor...</div>
    return;
}

@if (!string.IsNullOrWhiteSpace(_db.Message))
{
    <div class="alert alert-warning">@_db.Message</div>
}

<table class="table table-sm table-striped">
    <thead>
        <tr>
            <th style="width:80px;">Id</th>
            <th>Ad</th>
            <th>VergiNo</th>
            <th>Tip</th>
            <th>Telefon</th>
        </tr>
    </thead>
    <tbody>
        @if ((_db.Items?.Count ?? 0) == 0)
        {
            <tr><td colspan="5" class="text-muted text-center py-3">Kayıt yok.</td></tr>
        }
        else
        {
            @foreach (var m in _db.Items!)
            {
                <tr>
                    <td>@m.Id</td>
                    <td>@m.Ad</td>
                    <td>@(m.VergiNo ?? "-")</td>
                    <td>@(m.Tip ?? "-")</td>
                    <td>@(m.Telefon ?? "-")</td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private const string _sp = "Sp_User_Mukelleflerim";

    IMyDbModel<MukellefRow>? _db;

    public class MukellefRow
    {
        public int Id { get; set; }
        public string Ad { get; set; } = "";
        public string? VergiNo { get; set; }
        public string? Tip { get; set; }
        public string? Telefon { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _db = Provider.Create<MukellefRow>();

        var auth = await AuthStateTask;
        var idStr = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _ = int.TryParse(idStr, out var uid);

        _db.Parameters.PageNumber = 1;
        _db.Parameters.PageSize = 50;
        _db.Parameters.OrderBy = "Id desc";

        _db.Parameters.Where = new Dictionary<string, string>
            {
                ["CurrentUserId"] = uid.ToString()
            };

        await Provider.Execute(_db, _sp, isPagination: true);
    }
}

