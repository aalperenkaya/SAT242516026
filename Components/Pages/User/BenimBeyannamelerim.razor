@page "/user/beyannamelerim"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using SAT242516026.Models.MyDbModels
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IMyDbModel_Provider Provider

<h3 class="mb-3">Benim Beyannamelerim</h3>

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <div class="alert alert-info">@_msg</div>
}

@if (_db is null)
{
    <div class="alert alert-info">Yükleniyor...</div>
    return;
}

<table class="table table-sm table-striped">
    <thead>
        <tr>
            <th style="width:80px;">Id</th>
            <th>Mükellef</th>
            <th>Tip</th>
            <th style="width:90px;">Yıl</th>
            <th style="width:110px;">Dönem</th>
            <th>Durum</th>
        </tr>
    </thead>
    <tbody>
        @if ((_db.Items?.Count ?? 0) == 0)
        {
            <tr><td colspan="6" class="text-muted text-center py-3">Kayıt yok.</td></tr>
        }
        else
        {
            @foreach (var b in _db.Items!)
            {
                <tr>
                    <td>@b.Id</td>
                    <td>@(b.MukellefAd ?? "-")</td>
                    <td>@(b.BeyannameTipiAd ?? "-")</td>
                    <td>@b.Yil</td>
                    <td>@(b.Donem ?? "-")</td>
                    <td>@(b.Durum ?? "-")</td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private const string SP = "Sp_User_Beyannamelerim";

    private string? _msg;
    private int _uid;

    public class BeyanRow
    {
        public int Id { get; set; }
        public string? MukellefAd { get; set; }
        public string? BeyannameTipiAd { get; set; }
        public int Yil { get; set; }
        public string? Donem { get; set; }
        public string? Durum { get; set; }
    }

    private IMyDbModel<BeyanRow>? _db;

    protected override async Task OnInitializedAsync()
    {
        _db = Provider.Create<BeyanRow>();

        var auth = await AuthStateTask;
        var idStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        _ = int.TryParse(idStr, out _uid);

        if (_uid <= 0)
        {
            _msg = "Oturum yok. Tekrar giriş yap.";
            return;
        }

        _db.Parameters.PageNumber = 1;
        _db.Parameters.PageSize = 200;
        _db.Parameters.OrderBy = "Id desc";

        await Load();
    }

    private Task Load() => GetItems();

    private async Task GetItems()
    {
        if (_db is null) return;

        _db.Parameters.Where = new Dictionary<string, string>
            {
                ["CurrentUserId"] = _uid.ToString()
            };

        await Provider.Execute(_db, SP, isPagination: true);
        _msg = _db.Message;
    }
}
