@page "/user/tahakkuklarim"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using SAT242516026.Models.MyDbModels
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IMyDbModel_Provider Provider

<h3 class="mb-3">Benim Tahakkuklarım</h3>

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <div class="alert alert-info">@_msg</div>
}

@if (_db is null)
{
    <div class="alert alert-info">Yükleniyor...</div>
    return;
}

<table class="table table-sm table-striped">
    <thead>
        <tr>
            <th style="width:80px;">Id</th>
            <th style="width:120px;">BeyannameId</th>
            <th>Tutar</th>
            <th>Tarih</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in _db.Items ?? new())
        {
            <tr>
                <td>@t.Id</td>
                <td>@t.BeyannameId</td>
                <td>@t.Tutar</td>
                <td>@(t.Tarih?.ToString("yyyy-MM-dd") ?? "-")</td>
            </tr>
        }

        @if ((_db.Items?.Count ?? 0) == 0)
        {
            <tr>
                <td colspan="4" class="text-center text-muted py-3">Kayıt yok.</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    private const string SP = "Sp_User_Tahakkuklarim";

    private IMyDbModel<TahakkukRow>? _db;
    private string? _msg;
    private int _uid;

    public class TahakkukRow
    {
        public int Id { get; set; }
        public int BeyannameId { get; set; }
        public decimal Tutar { get; set; }
        public DateTime? Tarih { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        _db = Provider.Create<TahakkukRow>();

        var auth = await AuthStateTask;
        var idStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        _ = int.TryParse(idStr, out _uid);

        if (_uid <= 0)
        {
            _msg = "Kullanıcı bulunamadı / oturum yok.";
            return;
        }

        _db.Parameters.PageNumber = 1;
        _db.Parameters.PageSize = 200;
        _db.Parameters.OrderBy = "Id desc";

        await Load();
    }

    private Task Load() => GetItems();

    private async Task GetItems()
    {
        if (_db is null) return;

        _db.Parameters.Where = new Dictionary<string, string>
            {
                ["CurrentUserId"] = _uid.ToString()
            };

        await Provider.Execute(_db, SP, isPagination: true);
        _msg = _db.Message;
    }
}
