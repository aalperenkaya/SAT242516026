@page "/user/tahakkuklarim"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using SAT242516026.Data
@using SAT242516026.Models.MyDbModels
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject IMyDbModel<Tahakkuk> _db
@inject IMyDbModel_Provider _provider

<h3 class="mb-3">Benim Tahakkuklarım</h3>

@if (!string.IsNullOrWhiteSpace(_db.Message))
{
    <div class="alert alert-info">@_db.Message</div>
}

<table class="table table-sm table-striped">
    <thead>
        <tr>
            <th style="width:80px;">Id</th>
            <th style="width:120px;">BeyannameId</th>
            <th>Tutar</th>
            <th>Tarih</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in _db.Items)
        {
            <tr>
                <td>@t.Id</td>
                <td>@t.BeyannameId</td>
                <td>@t.Tutar</td>
                <td>@(t.Tarih?.ToString("yyyy-MM-dd") ?? "-")</td>
            </tr>
        }

        @if (_db.Items.Count == 0)
        {
            <tr>
                <td colspan="4" class="text-center text-muted py-3">Kayıt yok.</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;
    private readonly string _sp = "Sp_User_Tahakkuklarim";

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateTask;
        var idStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!int.TryParse(idStr, out var userId) || userId <= 0)
        {
            _db.Message = "Kullanıcı bulunamadı / oturum yok.";
            return;
        }

        _db.Parameters.PageNumber = 1;
        _db.Parameters.PageSize = 200;
        _db.Parameters.OrderBy = "Id desc";

        _db.Parameters.Where = new Dictionary<string, string>
        {
            { "CurrentUserId", userId.ToString() }
        };

        await _provider.Execute(_db, _sp, isPagination: true);
    }
}
