@page "/user/odemelerim"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using SAT242516026.Models.MyDbModels
@using System.Globalization
@using System.Text.Json

@inject IMyDbModel<UserDebtRow> DebtModel
@inject IMyDbModel<UserOdemeRow> OdemeModel
@inject IMyDbModel_Provider Provider
@inject IJSRuntime JS

<h3 class="mb-3">Benim Ödemelerim</h3>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="alert alert-info">@Message</div>
}

<div class="card mb-4">
    <div class="card-header fw-bold">Borçlarım (Tahakkuklar)</div>
    <div class="card-body">
        <table class="table table-sm table-striped align-middle">
            <thead>
                <tr>
                    <th style="width:90px;">TahakkukId</th>
                    <th>Beyanname</th>
                    <th style="width:140px;">Tahakkuk</th>
                    <th style="width:140px;">Ödenen</th>
                    <th style="width:140px;">Kalan</th>
                    <th style="width:160px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in DebtModel.Items)
                {
                    <tr>
                        <td>@row.TahakkukId</td>
                        <td>#@row.BeyannameId - @row.MukellefAd - @row.BeyannameTipiAd</td>
                        <td>@row.TahakkukTutar.ToString("C")</td>
                        <td>@row.Odenen.ToString("C")</td>
                        <td class="fw-bold">@row.Kalan.ToString("C")</td>
                        <td class="text-end">
                            @if (row.Kalan <= 0)
                            {
                                <span class="badge bg-success">Kapandı</span>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-primary" @onclick="() => StartPay(row)">Öde</button>
                            }
                        </td>
                    </tr>
                }

                @if (DebtModel.Items.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">Kayıt yok.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (PayOpen)
{
    <div class="card mb-4">
        <div class="card-header fw-bold">Ödeme Yap (Simülasyon / Fake)</div>
        <div class="card-body">
            <div class="alert alert-warning mb-3">
                Bu ekran “ödeme yapılmış” gibi kayıt oluşturur. Kart bilgileri DB’ye kaydedilmez.
            </div>

            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Seçili Tahakkuk</label>
                    <input class="form-control" value="@SelectedInfo" disabled />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Tutar</label>
                    <input type="number" step="0.01" class="form-control" @bind="PayAmount" />
                </div>

                <div class="col-md-6"></div>

                <div class="col-md-4">
                    <label class="form-label">Kart Üstündeki İsim</label>
                    <input class="form-control" @bind="CardName" />
                </div>

                <div class="col-md-4">
                    <label class="form-label">Kart No</label>
                    <input class="form-control" @bind="CardNumber" placeholder="1111 2222 3333 4444" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">SKT</label>
                    <input class="form-control" @bind="Exp" placeholder="12/27" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">CVC</label>
                    <input class="form-control" @bind="Cvc" placeholder="123" />
                </div>

                <div class="col-md-3">
                    <button class="btn btn-success w-100" @onclick="DoPay" disabled="@IsPaying">
                        @(IsPaying ? "İşleniyor..." : "Ödemeyi Tamamla")
                    </button>
                </div>

                <div class="col-md-3">
                    <button class="btn btn-outline-secondary w-100" @onclick="CancelPay" disabled="@IsPaying">
                        İptal
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<div class="card mb-5">
    <div class="card-header fw-bold">Geçmiş Ödemelerim</div>
    <div class="card-body">
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th style="width:90px;">Id</th>
                    <th style="width:120px;">TahakkukId</th>
                    <th>Tutar</th>
                    <th style="width:160px;">Ödeme Tarihi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in OdemeModel.Items)
                {
                    <tr>
                        <td>@o.Id</td>
                        <td>@o.TahakkukId</td>
                        <td>@o.Tutar.ToString("C")</td>
                        <td>@(o.OdemeTarihi?.ToString("yyyy-MM-dd") ?? "-")</td>
                    </tr>
                }

                @if (OdemeModel.Items.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-3">Kayıt yok.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    string? Message;
    int CurrentUserId;

    readonly string SpBorclar = "Sp_User_Borclarim";
    readonly string SpOdemeler = "Sp_User_Odemelerim";

    // ✅ FIX: Bu SP artık @where/@params JSON nvarchar alacak şekilde kullanılacak
    readonly string SpOdemeAdd = "Sp_Odeme_Add";

    bool PayOpen;
    bool IsPaying;

    int SelectedTahakkukId;
    string SelectedInfo = "";
    decimal PayAmount;

    string CardName = "";
    string CardNumber = "";
    string Exp = "";
    string Cvc = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadUserId();

        DebtModel.Parameters.PageNumber = 1;
        DebtModel.Parameters.PageSize = 200;
        DebtModel.Parameters.OrderBy = "TahakkukId desc";

        OdemeModel.Parameters.PageNumber = 1;
        OdemeModel.Parameters.PageSize = 300;
        OdemeModel.Parameters.OrderBy = "Id desc";

        await Refresh();
    }

    private async Task LoadUserId()
    {
        var authState = await AuthStateTask;
        var idStr = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        _ = int.TryParse(idStr, out CurrentUserId);
    }

    private async Task Refresh()
    {
        if (CurrentUserId <= 0)
        {
            Message = "Kullanıcı bulunamadı. Tekrar giriş yap.";
            return;
        }

        DebtModel.Parameters.Where = new Dictionary<string, string> { ["CurrentUserId"] = CurrentUserId.ToString() };
        OdemeModel.Parameters.Where = new Dictionary<string, string> { ["CurrentUserId"] = CurrentUserId.ToString() };

        await Provider.Execute(DebtModel, SpBorclar, isPagination: true);
        await Provider.Execute(OdemeModel, SpOdemeler, isPagination: true);

        Message = DebtModel.Message ?? OdemeModel.Message;
    }

    private void StartPay(UserDebtRow row)
    {
        PayOpen = true;
        SelectedTahakkukId = row.TahakkukId;
        SelectedInfo = $"Tahakkuk #{row.TahakkukId} | Kalan: {row.Kalan:C}";
        PayAmount = row.Kalan;

        CardName = "";
        CardNumber = "";
        Exp = "";
        Cvc = "";
        Message = null;
    }

    private void CancelPay()
    {
        PayOpen = false;
        IsPaying = false;
        Message = null;
    }

    private static string OnlyDigits(string s) => new string((s ?? "").Where(char.IsDigit).ToArray());

    private static bool ExpOk(string exp)
    {
        exp = (exp ?? "").Trim();
        var parts = exp.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length != 2) return false;
        if (!int.TryParse(parts[0], out var mm)) return false;
        if (!int.TryParse(parts[1], out var yy)) return false;
        return mm is >= 1 and <= 12 && yy >= 0;
    }

    private async Task DoPay()
    {
        Message = null;
        if (IsPaying) return;
        IsPaying = true;

        try
        {
            if (CurrentUserId <= 0) { Message = "Kullanıcı bulunamadı."; return; }
            if (SelectedTahakkukId <= 0) { Message = "Tahakkuk seçimi yok."; return; }
            if (PayAmount <= 0) { Message = "Ödeme tutarı 0 olamaz."; return; }

            // Fake kart doğrulama (DB’ye yazılmaz)
            if (string.IsNullOrWhiteSpace(CardName)) { Message = "Kart isim boş."; return; }
            if (OnlyDigits(CardNumber).Length < 12) { Message = "Kart numarası hatalı."; return; }
            if (!ExpOk(Exp)) { Message = "SKT hatalı. Örn: 12/27"; return; }
            if ((Cvc ?? "").Trim().Length < 3) { Message = "CVC hatalı."; return; }

            // ✅ FIX: SetItems Dictionary ALMAZ -> JSON string gönderiyoruz
            var whereObj = new Dictionary<string, string> { ["CurrentUserId"] = CurrentUserId.ToString() };
            var paramsObj = new Dictionary<string, string>
                {
                    ["TahakkukId"] = SelectedTahakkukId.ToString(),
                    ["Tutar"] = PayAmount.ToString(CultureInfo.InvariantCulture)
                };

            var whereJson = JsonSerializer.Serialize(whereObj);
            var paramsJson = JsonSerializer.Serialize(paramsObj);

            var result = await Provider.SetItems<ResultKV>(
                SpOdemeAdd,
                ("where", whereJson),
                ("params", paramsJson)
            );

            var r = result.FirstOrDefault();
            Message = r is null ? "Sonuç gelmedi." : r.Key;

            if (r?.Value == true)
            {
                PayOpen = false;
                await Refresh();
            }
        }
        catch (Exception ex)
        {
            Message = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            IsPaying = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public class ResultKV { public string Key { get; set; } = ""; public bool Value { get; set; } }

    public class UserDebtRow
    {
        public int TahakkukId { get; set; }
        public int BeyannameId { get; set; }
        public string? MukellefAd { get; set; }
        public string? BeyannameTipiAd { get; set; }
        public decimal TahakkukTutar { get; set; }
        public decimal Odenen { get; set; }
        public decimal Kalan { get; set; }
        public int TotalRecordCount { get; set; }
        public int TotalPageCount { get; set; }
    }

    public class UserOdemeRow
    {
        public int Id { get; set; }
        public int TahakkukId { get; set; }
        public decimal Tutar { get; set; }
        public DateTime? OdemeTarihi { get; set; }
        public int TotalRecordCount { get; set; }
        public int TotalPageCount { get; set; }
    }
}

