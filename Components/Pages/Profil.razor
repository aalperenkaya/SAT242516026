@page "/profil"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using SAT242516026.Data
@using SAT242516026.Models.Services
@using SAT242516026.Models.DbContexts

@inject AuthService Auth
@inject MyDbModel_Context Db

<h3>Profil</h3>

@if (_me is null)
{
    <p>Yükleniyor...</p>
}
else
{
    <div class="card p-3">
        <div><b>Kullanıcı:</b> @_me.KullaniciAdi</div>
        <div><b>Ad Soyad:</b> @_me.AdSoyad</div>
        <div><b>Email:</b> @_me.Email</div>
        <div><b>Rol:</b> @(_me.IsAdmin ? "Admin" : "Kullanıcı")</div>
    </div>

    <a class="btn btn-outline-danger mt-3" href="/auth/logout">Çıkış</a>
}

@code {
    private Kullanici? _me;

    protected override async Task OnInitializedAsync()
    {
        var id = Auth.GetUserId();
        if (id is null) return;

        _me = await Db.Kullanicilar.FindAsync(id.Value);
    }
}
