@page "/profil"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using SAT242516026.Models.MyDbModels
@using SAT242516026.Models.Services

@inject AuthService Auth
@inject IMyDbModel_Provider Provider

<h3>Profil</h3>

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <div class="alert alert-warning">@_msg</div>
}

@if (_me is null)
{
    <p>Yükleniyor...</p>
}
else
{
    <div class="card p-3">
        <div><b>Kullanıcı:</b> @_me.KullaniciAdi</div>
        <div><b>Ad Soyad:</b> @_me.AdSoyad</div>
        <div><b>Email:</b> @_me.Email</div>
        <div><b>Rol:</b> @(_me.IsAdmin ? "Admin" : "Kullanıcı")</div>
    </div>

    <a class="btn btn-outline-danger mt-3" href="/auth/logout">Çıkış</a>
}

@code {
    private string? _msg;
    private MeRow? _me;

    // SP dönüş modeli (kolon adlarıyla aynı tut)
    public class MeRow
    {
        public int Id { get; set; }
        public string KullaniciAdi { get; set; } = "";
        public string? AdSoyad { get; set; }
        public string? Email { get; set; }
        public bool IsAdmin { get; set; }
    }

    private const string SP_AUTH_ME = "sp_Auth_Me";

    protected override async Task OnInitializedAsync()
    {
        var id = Auth.GetUserId();
        if (id is null)
        {
            _msg = "Giriş bulunamadı.";
            return;
        }

        try
        {
            var rows = await Provider.SetItems<MeRow>(SP_AUTH_ME, ("@id", id.Value));
            _me = rows.FirstOrDefault();

            if (_me is null)
                _msg = "Kullanıcı bulunamadı.";
        }
        catch (Exception ex)
        {
            _msg = ex.InnerException?.Message ?? ex.Message;
        }
    }
}
