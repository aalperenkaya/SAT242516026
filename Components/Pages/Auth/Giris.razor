@page "/giris"
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Nav

<h3 class="mb-3">Giriş</h3>

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div class="alert alert-danger">@Error</div>
}

<div class="card" style="max-width:520px;">
    <div class="card-body">
        <form method="post" action="/auth/login">
            <div class="mb-3">
                <label class="form-label">Kullanıcı Adı</label>
                <input class="form-control" name="kullaniciAdi" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Şifre</label>
                <input type="password" class="form-control" name="sifre" required />
            </div>

            <button class="btn btn-primary w-100" type="submit">Giriş Yap</button>
        </form>

        <div class="mt-3">
            Hesabın yok mu? <a href="/kayit">Kayıt ol</a>
        </div>
    </div>
</div>

@code {
    string? Error;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var q = QueryHelpers.ParseQuery(uri.Query);

        if (!q.TryGetValue("err", out var err)) return;

        Error = err.ToString() switch
        {
            "bad_login" => "Kullanıcı adı veya şifre yanlış.",
            _ => "Giriş başarısız."
        };
    }
}
