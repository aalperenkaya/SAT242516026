@page "/admin/mukellefler"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

@using System.Text.Json
@using SAT242516026.Models.Enums
@using SAT242516026.Models.MyDbModels

@inject IMyDbModel_Provider Provider

<h3 class="mb-3">Admin - Mükellefler</h3>

@if (!string.IsNullOrWhiteSpace(_notice))
{
    <div class="alert alert-@_noticeType">@_notice</div>
}

@if (_db is null)
{
    <div>Yükleniyor...</div>
    return;
}

<div class="card mb-3">
    <div class="card-header fw-bold">Filtre / Sıralama / Sayfalama</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Ad</label>
                <input class="form-control"
                       @bind="F_Ad"
                       @bind:event="oninput"
                       @bind:after="OnChange_Filter" />
            </div>
            <div class="col-md-2">
                <label class="form-label">VergiNo</label>
                <input class="form-control"
                       @bind="F_VergiNo"
                       @bind:event="oninput"
                       @bind:after="OnChange_Filter" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Tip</label>
                <input class="form-control"
                       @bind="F_Tip"
                       @bind:event="oninput"
                       @bind:after="OnChange_Filter" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Telefon</label>
                <input class="form-control"
                       @bind="F_Telefon"
                       @bind:event="oninput"
                       @bind:after="OnChange_Filter" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Sırala</label>
                <select class="form-select"
                        @bind="OrderBy"
                        @bind:after="OnChange_OrderBy">
                    @foreach (var ob in OrderByItems)
                    {
                        <option value="@ob.Value">@ob.Key</option>
                    }
                </select>
            </div>

            <div class="col-md-1">
                <label class="form-label">Boyut</label>
                <select class="form-select"
                        @bind="PageSize"
                        @bind:after="OnChange_PageSize">
                    @foreach (var ps in new[] { 5, 10, 20, 50, 100 })
                    {
                        <option value="@ps">@ps</option>
                    }
                </select>
            </div>

            <div class="col-md-1">
                <button type="button" class="btn btn-primary w-100" @onclick="Load">Uygula</button>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="small text-muted">@_rangeText</div>

            <div class="d-flex gap-2 align-items-center">
                <div class="small text-muted">Sayfa</div>
                <select class="form-select form-select-sm" style="width:120px;"
                        @bind="_db.Parameters.PageNumber"
                        @bind:after="OnChange_PageNumber">
                    @{
                        var total = _db.Parameters.TotalPageCount;
                        if (total < 1) total = 1;
                        for (int p = 1; p <= total; p++)
                        {
                            <option value="@p">@p</option>
                        }
                    }
                </select>

                <div class="btn-group">
                    <button type="button" class="btn btn-outline-secondary"
                            @onclick='() => OnClick_PageNumber("first")'
                            disabled="@(_db.Parameters.PageNumber<=1)">
                        &lt;&lt;
                    </button>

                    <button type="button" class="btn btn-outline-secondary"
                            @onclick='() => OnClick_PageNumber("prev")'
                            disabled="@(_db.Parameters.PageNumber<=1)">
                        &lt;
                    </button>

                    <button type="button" class="btn btn-outline-secondary" disabled>
                        @_db.Parameters.PageNumber / @_db.Parameters.TotalPageCount
                    </button>

                    <button type="button" class="btn btn-outline-secondary"
                            @onclick='() => OnClick_PageNumber("next")'
                            disabled="@(_db.Parameters.PageNumber>=_db.Parameters.TotalPageCount)">
                        &gt;
                    </button>

                    <button type="button" class="btn btn-outline-secondary"
                            @onclick='() => OnClick_PageNumber("last")'
                            disabled="@(_db.Parameters.PageNumber>=_db.Parameters.TotalPageCount)">
                        &gt;&gt;
                    </button>
                </div>
            </div>

            <button type="button" class="btn btn-outline-danger" @onclick="OnChange_Filter_Reset">Sıfırla</button>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-bold">Mükellef (Ekle / Güncelle)</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">

            <div class="col-md-4">
                <label class="form-label">Ad*</label>
                <input class="form-control" @bind="_model.Ad" />
            </div>

            <div class="col-md-2">
                <label class="form-label">VergiNo</label>
                <input class="form-control" @bind="_model.VergiNo" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Tip</label>
                <input class="form-control" @bind="_model.Tip" placeholder="Gerçek/Tüzel" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Telefon</label>
                <input class="form-control" @bind="_model.Telefon" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Kullanıcı*</label>
                <select class="form-select" @bind="_model.KullaniciId">
                    <option value="0">Seç...</option>
                    @foreach (var u in _users)
                    {
                        <option value="@u.Id">@u.KullaniciAdi (@u.Id)</option>
                    }
                </select>
            </div>

            <div class="col-md-2 mt-2">
                <button type="button" class="btn btn-success w-100" @onclick="OnClick_Save">
                    @(_operation == Operations.Add ? "Ekle" : "Güncelle")
                </button>

                @if (_operation != Operations.Add)
                {
                    <button type="button" class="btn btn-outline-secondary w-100 mt-2" @onclick="OnClick_Cancel">İptal</button>
                }
            </div>
        </div>

        <hr />

        <div class="table-responsive main-scroll">
            <table class="table table-sm table-striped align-middle mb-0">
                <thead style="position: sticky; top: 0; background: white; z-index: 2;">
                    <tr>
                        <th style="width:80px;">Id</th>
                        <th>Ad</th>
                        <th style="width:140px;">VergiNo</th>
                        <th style="width:120px;">Tip</th>
                        <th style="width:140px;">Telefon</th>
                        <th style="width:120px;">KullaniciId</th>
                        <th style="width:190px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in _db.Items ?? new())
                    {
                        <tr>
                            <td>@m.Id</td>
                            <td>@m.Ad</td>
                            <td>@m.VergiNo</td>
                            <td>@m.Tip</td>
                            <td>@m.Telefon</td>
                            <td>@m.KullaniciId</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary me-2"
                                        @onclick='() => OnClick_Operation("update", m)'>
                                    Güncelle
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        @onclick='() => OnClick_Operation("remove", m)'>
                                    Sil
                                </button>
                            </td>
                        </tr>
                    }

                    @if ((_db.Items?.Count ?? 0) == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-3">Kayıt yok.</td></tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

@code {
    private const string SP_LIST = "Sp_Mukellefler";
    private const string SP_AUR = "sp_Mukellef_Add_Update_Remove";
    private const string SP_USERS = "Sp_Kullanicilar_Lookup";

    IMyDbModel<MukellefRow>? _db;

    string? _notice;
    string _noticeType = "info";
    void Notice(string msg, string type = "info") { _notice = msg; _noticeType = type; }

    private Operations _operation = Operations.Add;
    private MukellefRow _model = new();

    private List<UserLookupRow> _users = new();

    string? F_Ad;
    string? F_VergiNo;
    string? F_Tip;
    string? F_Telefon;

    string OrderBy = "Id desc";
    int PageSize = 10;

    string _rangeText = "0 - 0 / 0";

    Dictionary<string, string> OrderByItems = new()
    {
        { "Id ↓", "Id desc" },
        { "Id ↑", "Id asc" },
        { "Ad ↑", "Ad asc" },
        { "Ad ↓", "Ad desc" },
        { "VergiNo ↑", "VergiNo asc" },
        { "VergiNo ↓", "VergiNo desc" },
        { "Tip ↑", "Tip asc" },
        { "Tip ↓", "Tip desc" },
        { "Telefon ↑", "Telefon asc" },
        { "Telefon ↓", "Telefon desc" },
        { "KullaniciId ↑", "KullaniciId asc" },
        { "KullaniciId ↓", "KullaniciId desc" },
    };

    public class MukellefRow
    {
        public int Id { get; set; }
        public string Ad { get; set; } = "";
        public string? VergiNo { get; set; }
        public string? Tip { get; set; }
        public string? Telefon { get; set; }
        public int KullaniciId { get; set; }
    }

    public class UserLookupRow
    {
        public int Id { get; set; }
        public string KullaniciAdi { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        _db = Provider.Create<MukellefRow>();

        await LoadUsers();

        _db.Parameters.PageNumber = 1;
        _db.Parameters.PageSize = PageSize;
        _db.Parameters.OrderBy = OrderBy;

        await Load();
    }

    async Task LoadUsers()
    {
        try
        {
            _users = await Provider.SetItems<UserLookupRow>(SP_USERS);
        }
        catch (Exception ex)
        {
            _users = new();
            Notice("Kullanıcı listesi alınamadı: " + (ex.InnerException?.Message ?? ex.Message), "warning");
        }
    }

    void RefreshRangeText()
    {
        var total = _db?.Parameters.TotalRecordCount ?? 0;
        var page = _db?.Parameters.PageNumber ?? 1;
        var size = _db?.Parameters.PageSize ?? 10;

        if (total <= 0) { _rangeText = "0 - 0 / 0"; return; }

        var start = (page - 1) * size + 1;
        var end = Math.Min(total, page * size);
        _rangeText = $"{start} - {end} / {total}";
    }

    // =========================================================
    // ✅ İstenen: GetItems()
    // =========================================================
    private async Task GetItems()
    {
        if (_db is null) return;

        _db.Parameters.PageSize = PageSize;
        _db.Parameters.OrderBy = OrderBy;

        var where = new Dictionary<string, string>();
        if (!string.IsNullOrWhiteSpace(F_Ad)) where["Ad"] = F_Ad.Trim();
        if (!string.IsNullOrWhiteSpace(F_VergiNo)) where["VergiNo"] = F_VergiNo.Trim();
        if (!string.IsNullOrWhiteSpace(F_Tip)) where["Tip"] = F_Tip.Trim();
        if (!string.IsNullOrWhiteSpace(F_Telefon)) where["Telefon"] = F_Telefon.Trim();

        _db.Parameters.Where = where.Count == 0 ? null : where;

        await Provider.Execute(_db, SP_LIST, isPagination: true);

        if (!string.IsNullOrWhiteSpace(_db.Message))
            Notice(_db.Message!, "warning");

        if (_db.Parameters.TotalPageCount <= 0) _db.Parameters.TotalPageCount = 1;
        if (_db.Parameters.PageNumber < 1) _db.Parameters.PageNumber = 1;
        if (_db.Parameters.PageNumber > _db.Parameters.TotalPageCount)
            _db.Parameters.PageNumber = _db.Parameters.TotalPageCount;

        RefreshRangeText();
    }

    // =========================================================
    // ✅ İstenen: Load()
    // =========================================================
    private Task Load() => GetItems();

    // =========================================================
    // ✅ İstenen: OnChange_Filter()
    // =========================================================
    private async Task OnChange_Filter()
    {
        if (_db is null) return;
        _db.Parameters.PageNumber = 1;
        await GetItems();
    }

    // =========================================================
    // ✅ İstenen: OnChange_OrderBy()
    // =========================================================
    private async Task OnChange_OrderBy()
    {
        if (_db is null) return;
        _db.Parameters.PageNumber = 1;
        await GetItems();
    }

    // =========================================================
    // ✅ İstenen: OnChange_PageSize()
    // =========================================================
    private async Task OnChange_PageSize()
    {
        if (_db is null) return;

        if (PageSize <= 0) PageSize = 10;
        if (PageSize > 200) PageSize = 200;

        _db.Parameters.PageNumber = 1;
        await GetItems();
    }

    // =========================================================
    // ✅ İstenen: OnChange_Filter_Reset()
    // =========================================================
    private async Task OnChange_Filter_Reset()
    {
        if (_db is null) return;

        F_Ad = F_VergiNo = F_Tip = F_Telefon = null;
        OrderBy = "Id desc";
        PageSize = 10;

        _db.Parameters.PageNumber = 1;

        OnClick_Cancel();
        await GetItems();
    }

    // =========================================================
    // ✅ İstenen: OnChange_PageNumber()
    // (dropdown’dan)
    // =========================================================
    private async Task OnChange_PageNumber()
    {
        if (_db is null) return;

        var max = _db.Parameters.TotalPageCount;
        if (max < 1) max = 1;

        if (_db.Parameters.PageNumber < 1) _db.Parameters.PageNumber = 1;
        if (_db.Parameters.PageNumber > max) _db.Parameters.PageNumber = max;

        await GetItems();
    }

    // yardımcı: butonla sayfa değişimi
    private async Task OnClick_PageNumber(string action)
    {
        if (_db is null) return;

        action = (action ?? "").Trim().ToLowerInvariant();

        if (action == "first") _db.Parameters.PageNumber = 1;
        else if (action == "prev" && _db.Parameters.PageNumber > 1) _db.Parameters.PageNumber--;
        else if (action == "next" && _db.Parameters.PageNumber < _db.Parameters.TotalPageCount) _db.Parameters.PageNumber++;
        else if (action == "last") _db.Parameters.PageNumber = _db.Parameters.TotalPageCount;

        await GetItems();
    }

    private void StartEdit(MukellefRow m)
    {
        _operation = Operations.Update;
        _model = new MukellefRow
            {
                Id = m.Id,
                Ad = m.Ad,
                VergiNo = m.VergiNo,
                Tip = m.Tip,
                Telefon = m.Telefon,
                KullaniciId = m.KullaniciId
            };
        Notice("Düzenleme modunda.", "info");
    }

    // =========================================================
    // ✅ İstenen: OnClick_Cancel()
    // =========================================================
    private void OnClick_Cancel()
    {
        _operation = Operations.Add;
        _model = new MukellefRow();
        Notice("İptal edildi.", "info");
    }

    // =========================================================
    // ✅ İstenen: OnClick_Save()
    // =========================================================
    private Task OnClick_Save() => OnClick_Operation();

    // =========================================================
    // ✅ İstenen: OnClick_Operation()
    // add/update işlemi
    // =========================================================
    private async Task OnClick_Operation()
    {
        _notice = null;

        if (string.IsNullOrWhiteSpace(_model.Ad))
        {
            Notice("Ad zorunlu.", "warning");
            return;
        }
        if (_model.KullaniciId <= 0)
        {
            Notice("Kullanıcı seç.", "warning");
            return;
        }

        var json = JsonSerializer.Serialize(_model);
        var op = _operation == Operations.Add ? "add" : "update";

        var result = await Provider.SetItems<MyDbModel_Result_KeyValue<string, bool>>(
            SP_AUR,
            ("@operation", op),
            ("@jsonvalues", json)
        );

        var r = result.FirstOrDefault();
        if (r?.Value == true) Notice(r.Key ?? "İşlem başarılı", "success");
        else Notice(r?.Key ?? "İşlem başarısız", "danger");

        OnClick_Cancel();
        await GetItems();
    }

    private async Task Delete(int id)
    {
        _notice = null;

        var json = JsonSerializer.Serialize(new { Id = id });

        var result = await Provider.SetItems<MyDbModel_Result_KeyValue<string, bool>>(
            SP_AUR,
            ("@operation", "remove"),
            ("@jsonvalues", json)
        );

        var r = result.FirstOrDefault();
        if (r?.Value == true) Notice(r.Key ?? "Silindi", "success");
        else Notice(r?.Key ?? "Silinemedi", "danger");

        if (_model.Id == id) OnClick_Cancel();
        await GetItems();
    }

    // Tablo butonları bunu çağırıyor (update/remove)
    private async Task OnClick_Operation(string operation, MukellefRow? row = null)
    {
        _notice = null;
        operation = (operation ?? "").Trim().ToLowerInvariant();

        switch (operation)
        {
            case "add":
                OnClick_Cancel();
                break;

            case "update":
            case "detail":
                if (row is null) { Notice("Satır seçilmedi.", "warning"); return; }
                StartEdit(row);
                break;

            case "remove":
            case "delete":
                if (row is null) { Notice("Silinecek satır seçilmedi.", "warning"); return; }
                await Delete(row.Id);
                break;

            default:
                Notice($"Bilinmeyen işlem: {operation}", "warning");
                break;
        }
    }
}
