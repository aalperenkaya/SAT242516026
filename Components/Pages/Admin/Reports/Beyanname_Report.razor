@page "/admin/reports/beyannameler"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

@using SAT242516026.Data
@using SAT242516026.Models.MyReports
@using SAT242516026.Models.MyDbModels

@inject IMyDbModel<Beyanname> BeyanDb
@inject IMyDbModel_Provider Provider

<h3>Admin - Beyanname Raporu (PDF)</h3>

@if (!string.IsNullOrEmpty(_pdfDataUrl))
{
    <iframe src="@_pdfDataUrl" style="width:100%; height:700px; border:1px solid #ddd;"></iframe>
}
else
{
    <p>Yükleniyor...</p>
}

@code {
    private string? _pdfDataUrl;
    private readonly string _spBeyan_List = "Sp_Beyannameler";

    protected override async Task OnInitializedAsync()
    {
        BeyanDb.Parameters.PageNumber = 1;
        BeyanDb.Parameters.PageSize = 300;
        BeyanDb.Parameters.OrderBy = "Id desc";
        BeyanDb.Parameters.Where = new Dictionary<string, string>();

        await Provider.Execute(BeyanDb, _spBeyan_List, isPagination: true);

        var rows = BeyanDb.Items
            .Select(x => new BeyannameRow
                {
                    Id = x.Id,
                    MukellefAd = x.MukellefId > 0 ? ("#" + x.MukellefId) : "-",
                    TipAd = x.BeyannameTipiId > 0 ? ("#" + x.BeyannameTipiId) : "-",
                    Yil = x.Yil,
                    Donem = x.Donem ?? "",
                    Durum = x.Durum ?? "",
                    SonTarih = x.SonGondermeTarihi.HasValue
                        ? x.SonGondermeTarihi.Value.ToString("dd.MM.yyyy")
                        : "-"
                })
            .ToList();

        var report = new Report_BeyannameList();
        var pdfBytes = report.Generate(rows);

        _pdfDataUrl = $"data:application/pdf;base64,{Convert.ToBase64String(pdfBytes)}";
    }
}
