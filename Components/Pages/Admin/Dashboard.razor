@page "/admin/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

@using SAT242516026.Models.MyDbModels
@inject IMyDbModel_Provider Provider
@inject IJSRuntime JS

<h3 class="mb-3">Admin Dashboard</h3>

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <div class="alert alert-info">@_msg</div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header fw-bold">Kayıt Sayıları</div>
            <div class="card-body" style="height:260px;">
                <canvas id="chartBar1"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header fw-bold">Duruma Göre Beyanname</div>
            <div class="card-body" style="height:260px;">
                <canvas id="chartBarDurum"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header fw-bold">Tahakkuk / Ödeme / Kalan</div>
            <div class="card-body" style="height:260px;">
                <canvas id="chartBarFin"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header fw-bold">Aylara Göre Ödeme</div>
            <div class="card-body" style="height:260px;">
                <canvas id="chartLineAy"></canvas>
            </div>
        </div>
    </div>
</div>

@code {
    private string? _msg;

    // çizim kontrolü
    private bool _dataLoaded;
    private bool _chartsDrawn;

    private const string SP_COUNTS = "Sp_Dashboard_Counts";
    private const string SP_DURUM = "Sp_Dashboard_Durum";
    private const string SP_FIN = "Sp_Dashboard_Finans";
    private const string SP_AY = "Sp_Dashboard_OdemeAylik";

    // SP kolon adlarıyla aynı olsun
    public class CountRow
    {
        public int Mukellef { get; set; }
        public int Beyanname { get; set; }
        public int Tahakkuk { get; set; }
        public int Odeme { get; set; }
    }

    public class DurumRow
    {
        public string Durum { get; set; } = "Bilinmiyor";
        public int Cnt { get; set; }
    }

    public class FinRow
    {
        public decimal ToplamTahakkuk { get; set; }
        public decimal ToplamOdeme { get; set; }
    }

    public class AyRow
    {
        public string Ay { get; set; } = "";
        public decimal Tutar { get; set; }
    }

    // Chart.js dataset formatı
    public class ChartSeries
    {
        public string label { get; set; } = "";
        public double[] data { get; set; } = Array.Empty<double>();
        public int borderWidth { get; set; } = 2;
        public bool fill { get; set; } = false;
        public double? tension { get; set; }
    }

    private static ChartSeries[] Series(string label, IEnumerable<double> data, bool fill = false, double? tension = null)
        => new[] { new ChartSeries { label = label, data = data.ToArray(), fill = fill, tension = tension } };

    
    private static List<ChartSeries> GetSeriesList(
        params (string label, IEnumerable<double> data, bool fill, double? tension, int borderWidth)[] series
    )
    {
        var list = new List<ChartSeries>();

        foreach (var s in series)
        {
            list.Add(new ChartSeries
                {
                    label = s.label,
                    data = s.data?.ToArray() ?? Array.Empty<double>(),
                    fill = s.fill,
                    tension = s.tension,
                    borderWidth = s.borderWidth <= 0 ? 2 : s.borderWidth
                });
        }

        if (list.Count == 0)
            list.Add(new ChartSeries { label = "Boş", data = Array.Empty<double>(), borderWidth = 2 });

        return list;
    }

    // =========================
    // DASHBOARD STATE (veriler)
    // =========================
    private CountRow _counts = new();
    private List<DurumRow> _durum = new();
    private FinRow _fin = new();
    private List<AyRow> _aylik = new();

    private async Task GetItems()
    {
        try
        {
            _msg = null;

            _counts = (await Provider.SetItems<CountRow>(SP_COUNTS)).FirstOrDefault() ?? new CountRow();
            _durum = await Provider.SetItems<DurumRow>(SP_DURUM);
            _fin = (await Provider.SetItems<FinRow>(SP_FIN)).FirstOrDefault() ?? new FinRow();
            _aylik = await Provider.SetItems<AyRow>(SP_AY);

            _dataLoaded = true;
        }
        catch (Exception ex)
        {
            _msg = ex.InnerException?.Message ?? ex.Message;
            _dataLoaded = false;
        }
    }

    private async Task Load()
    {
        await GetItems();
        _chartsDrawn = false; // veri yenilendiyse yeniden çizilebilir
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    // ✅ UPDATED: daha sağlam OnAfterRenderAsync (hocanın isteklerini bozmadan)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // veri yoksa veya zaten çizildiyse çık
        if (!_dataLoaded || _chartsDrawn) return;

        try
        {
            // Chart.js / helper scriptleri bazen geç geliyor: kısa retry
            var ok = false;
            for (var i = 0; i < 6; i++)
            {
                await Task.Delay(80);

                ok = await JS.InvokeAsync<bool>("eval",
                    "typeof window.drawBarChart==='function' && typeof window.drawLineChart==='function'");

                if (ok) break;
            }

            if (!ok)
            {
                _msg = "Chart.js helper fonksiyonları bulunamadı (drawBarChart/drawLineChart). wwwroot/js dosyanı ve _Host/Index script include'larını kontrol et.";
                await JS.InvokeVoidAsync("alert", _msg);
                return;
            }

            // 1) Counts
            await JS.InvokeVoidAsync("drawBarChart",
                "chartBar1",
                new[] { "Mükellef", "Beyanname", "Tahakkuk", "Ödeme" },
                GetSeriesList(
                    ("Toplam", new double[] { _counts.Mukellef, _counts.Beyanname, _counts.Tahakkuk, _counts.Odeme }, false, null, 2)
                ),
                true, true, "x"
            );

            // 2) Durum
            await JS.InvokeVoidAsync("drawBarChart",
                "chartBarDurum",
                _durum.Select(x => x.Durum).ToArray(),
                GetSeriesList(
                    ("Adet", _durum.Select(x => (double)x.Cnt), false, null, 2)
                ),
                true, true, "x"
            );

            // 3) Finans
            var kalan = _fin.ToplamTahakkuk - _fin.ToplamOdeme;

            await JS.InvokeVoidAsync("drawBarChart",
                "chartBarFin",
                new[] { "Tahakkuk", "Ödeme", "Kalan" },
                GetSeriesList(
                    ("Tutar", new double[]
                    {
                        (double)_fin.ToplamTahakkuk,
                        (double)_fin.ToplamOdeme,
                        (double)kalan
                    }, false, null, 2)
                ),
                true, true, "x"
            );

            // 4) Aylık ödeme (line)
            await JS.InvokeVoidAsync("drawLineChart",
                "chartLineAy",
                _aylik.Select(x => x.Ay).ToArray(),
                GetSeriesList(
                    ("Ödeme", _aylik.Select(x => (double)x.Tutar), true, 0.25, 2)
                ),
                true, true, true, 0.25
            );

            _chartsDrawn = true;
            _msg = null;
        }
        catch (Exception ex)
        {
            _msg = ex.InnerException?.Message ?? ex.Message;
            await JS.InvokeVoidAsync("alert", _msg);
            await InvokeAsync(StateHasChanged);
        }
    }
}
