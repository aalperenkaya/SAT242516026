@page "/admin/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

@using SAT242516026.Models.MyDbModels
@inject IMyDbModel_Provider Provider
@inject IJSRuntime JS

<h3 class="mb-3">Admin Dashboard</h3>

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <div class="alert alert-info">@_msg</div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header fw-bold">Kayıt Sayıları</div>
            <div class="card-body" style="height:260px;">
                <canvas id="chartBar1"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header fw-bold">Duruma Göre Beyanname</div>
            <div class="card-body" style="height:260px;">
                <canvas id="chartBarDurum"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header fw-bold">Tahakkuk / Ödeme / Kalan</div>
            <div class="card-body" style="height:260px;">
                <canvas id="chartBarFin"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header fw-bold">Aylara Göre Ödeme</div>
            <div class="card-body" style="height:260px;">
                <canvas id="chartLineAy"></canvas>
            </div>
        </div>
    </div>
</div>

@code {
    private bool _drawn;
    private string? _msg;

    private const string SP_COUNTS = "Sp_Dashboard_Counts";
    private const string SP_DURUM = "Sp_Dashboard_Durum";
    private const string SP_FIN = "Sp_Dashboard_Finans";
    private const string SP_AY = "Sp_Dashboard_OdemeAylik";

    // SP kolon adlarıyla aynı olsun (mapping derdi çıkmasın)
    public class CountRow
    {
        public int Mukellef { get; set; }
        public int Beyanname { get; set; }
        public int Tahakkuk { get; set; }
        public int Odeme { get; set; }
    }

    public class DurumRow
    {
        public string Durum { get; set; } = "Bilinmiyor";
        public int Cnt { get; set; }
    }

    public class FinRow
    {
        public decimal ToplamTahakkuk { get; set; }
        public decimal ToplamOdeme { get; set; }
    }

    public class AyRow
    {
        public string Ay { get; set; } = "";
        public decimal Tutar { get; set; }
    }

    // Chart.js dataset formatı
    public class ChartSeries
    {
        public string label { get; set; } = "";
        public double[] data { get; set; } = Array.Empty<double>();
        public int borderWidth { get; set; } = 2;
        public bool fill { get; set; } = false;
        public double? tension { get; set; }
    }

    private static ChartSeries[] Series(string label, IEnumerable<double> data, bool fill = false, double? tension = null)
        => new[] { new ChartSeries { label = label, data = data.ToArray(), fill = fill, tension = tension } };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _drawn) return;
        _drawn = true;

        try
        {
            // Chart.js scriptleri daha yeni yüklenmiş olabiliyor → mini bekleme
            await Task.Delay(50);

            // 1) Counts
            var counts = (await Provider.SetItems<CountRow>(SP_COUNTS)).FirstOrDefault() ?? new CountRow();

            await JS.InvokeVoidAsync("drawBarChart",
                "chartBar1",
                new[] { "Mükellef", "Beyanname", "Tahakkuk", "Ödeme" },
                Series("Toplam", new double[] { counts.Mukellef, counts.Beyanname, counts.Tahakkuk, counts.Odeme }),
                true, true, "x"
            );

            // 2) Durum
            var durum = await Provider.SetItems<DurumRow>(SP_DURUM);
            await JS.InvokeVoidAsync("drawBarChart",
                "chartBarDurum",
                durum.Select(x => x.Durum).ToArray(),
                Series("Adet", durum.Select(x => (double)x.Cnt)),
                true, true, "x"
            );

            // 3) Finans
            var fin = (await Provider.SetItems<FinRow>(SP_FIN)).FirstOrDefault() ?? new FinRow();
            var kalan = fin.ToplamTahakkuk - fin.ToplamOdeme;

            await JS.InvokeVoidAsync("drawBarChart",
                "chartBarFin",
                new[] { "Tahakkuk", "Ödeme", "Kalan" },
                Series("Tutar", new double[] { (double)fin.ToplamTahakkuk, (double)fin.ToplamOdeme, (double)kalan }),
                true, true, "x"
            );

            // 4) Aylık ödeme
            var aylik = await Provider.SetItems<AyRow>(SP_AY);
            await JS.InvokeVoidAsync("drawLineChart",
                "chartLineAy",
                aylik.Select(x => x.Ay).ToArray(),
                Series("Ödeme", aylik.Select(x => (double)x.Tutar), fill: true, tension: 0.25),
                true, true, true, 0.25
            );

            _msg = null;
        }
        catch (Exception ex)
        {
            _msg = ex.InnerException?.Message ?? ex.Message;
            await JS.InvokeVoidAsync("alert", _msg);
            await InvokeAsync(StateHasChanged);
        }
    }
}
