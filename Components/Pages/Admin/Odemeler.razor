@page "/admin/odemeler"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

@using System.Globalization
@using System.Text.Json
@using SAT242516026.Models.MyDbModels

@inject IMyDbModel_Provider Provider
@inject IJSRuntime JS

<h3 class="mb-3">Admin - Ödemeler</h3>

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <div class="alert alert-info">@_msg</div>
}

<div class="card mb-3">
    <div class="card-header fw-bold">Filtre / Sıralama / Sayfalama</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">TahakkukId</label>
                <input type="number" class="form-control"
                       @bind="_fTahakkukId"
                       @bind:event="oninput"
                       @bind:after="OnChange_Filter" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Min Tutar</label>
                <input type="number" step="0.01" class="form-control"
                       @bind="_fMin"
                       @bind:event="oninput"
                       @bind:after="OnChange_Filter" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Max Tutar</label>
                <input type="number" step="0.01" class="form-control"
                       @bind="_fMax"
                       @bind:event="oninput"
                       @bind:after="OnChange_Filter" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Ödeme Tarihi</label>
                <input type="date" class="form-control"
                       @bind="_fTarih"
                       @bind:after="OnChange_Filter" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Sırala</label>
                <select class="form-select"
                        @bind="_orderBy"
                        @bind:after="OnChange_OrderBy">
                    <option value="Id desc">Id ↓</option>
                    <option value="Id asc">Id ↑</option>
                    <option value="Tutar desc">Tutar ↓</option>
                    <option value="Tutar asc">Tutar ↑</option>
                    <option value="OdemeTarihi desc">Tarih ↓</option>
                    <option value="OdemeTarihi asc">Tarih ↑</option>
                    <option value="TahakkukId desc">TahakkukId ↓</option>
                    <option value="TahakkukId asc">TahakkukId ↑</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Boyut</label>
                <select class="form-select"
                        @bind="_pageSize"
                        @bind:after="OnChange_PageSize">
                    @foreach (var ps in new[] { 5, 10, 20, 50, 100 })
                    {
                        <option value="@ps">@ps</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <button type="button" class="btn btn-primary w-100" @onclick="Load">Uygula</button>
            </div>

            <div class="col-md-2">
                <button type="button" class="btn btn-outline-danger w-100" @onclick="OnChange_Filter_Reset">Sıfırla</button>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="small text-muted">
                @($"{(_db?.Parameters.TotalRecordCount ?? 0)} kayıt | Sayfa: {_pageNumber}/{_db?.Parameters.TotalPageCount ?? 1}")
            </div>

            <div class="d-flex gap-2 align-items-center">
                <div class="small text-muted">Sayfa</div>
                <select class="form-select form-select-sm" style="width:120px;"
                        @bind="_pageNumber"
                        @bind:after="OnChange_PageNumber">
                    @{
                        var total = _db?.Parameters.TotalPageCount ?? 1;
                        if (total < 1) total = 1;
                        for (int p = 1; p <= total; p++)
                        {
                            <option value="@p">@p</option>
                        }
                    }
                </select>

                <div class="btn-group">
                    <button type="button" class="btn btn-outline-secondary"
                            @onclick='() => OnClick_PageNumber("first")'
                            disabled="@(_pageNumber<=1)">
                        &lt;&lt;
                    </button>
                    <button type="button" class="btn btn-outline-secondary"
                            @onclick='() => OnClick_PageNumber("prev")'
                            disabled="@(_pageNumber<=1)">
                        &lt;
                    </button>
                    <button type="button" class="btn btn-outline-secondary" disabled>
                        @_pageNumber / @(_db?.Parameters.TotalPageCount ?? 1)
                    </button>
                    <button type="button" class="btn btn-outline-secondary"
                            @onclick='() => OnClick_PageNumber("next")'
                            disabled="@(_db is null || _pageNumber>=_db.Parameters.TotalPageCount)">
                        &gt;
                    </button>
                    <button type="button" class="btn btn-outline-secondary"
                            @onclick='() => OnClick_PageNumber("last")'
                            disabled="@(_db is null || _pageNumber>=_db.Parameters.TotalPageCount)">
                        &gt;&gt;
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-5">
    <div class="card-header fw-bold">Ödeme (Ekle / Güncelle)</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label">Tahakkuk*</label>
                <select class="form-select" @bind="_form.TahakkukId">
                    <option value="0">Seç...</option>
                    @foreach (var t in _tahakkukLookup)
                    {
                        <option value="@t.Id">#@t.Id - @t.Tutar</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Tutar*</label>
                <input type="number" step="0.01" class="form-control" @bind="_form.Tutar" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Ödeme Tarihi</label>
                <input type="date" class="form-control" @bind="_form.OdemeTarihi" />
            </div>

            <div class="col-md-2">
                <button type="button" class="btn btn-success w-100" @onclick="OnClick_Save">
                    @(_editId is null ? "Ekle" : "Güncelle")
                </button>

                @if (_editId is not null)
                {
                    <button type="button" class="btn btn-outline-secondary w-100 mt-2" @onclick="OnClick_Cancel">İptal</button>
                }
            </div>
        </div>

        <hr />

        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:80px;">Id</th>
                        <th style="width:120px;">TahakkukId</th>
                        <th>Tutar</th>
                        <th>Ödeme Tarihi</th>
                        <th style="width:190px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if ((_db?.Items?.Count ?? 0) > 0)
                    {
                        @foreach (var o in _db!.Items!)
                        {
                            <tr>
                                <td>@o.Id</td>
                                <td>@o.TahakkukId</td>
                                <td>@o.Tutar</td>
                                <td>@(o.OdemeTarihi?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary me-2"
                                            @onclick="() => StartEdit(o)">
                                        Güncelle
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            @onclick="() => Delete(o.Id)">
                                        Sil
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center text-muted py-3">Henüz ödeme yok.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private const string SP_LIST = "Sp_Odemeler";
    private const string SP_AUR = "sp_Odeme_Add_Update_Remove";
    private const string SP_TLK = "Sp_TahakkukLookup";

    private string? _msg;

    public class OdemeRow
    {
        public int Id { get; set; }
        public int TahakkukId { get; set; }
        public decimal Tutar { get; set; }
        public DateTime? OdemeTarihi { get; set; }
    }

    public class TahakkukLookupRow
    {
        public int Id { get; set; }
        public decimal Tutar { get; set; }
    }

    private IMyDbModel<OdemeRow>? _db;
    private List<TahakkukLookupRow> _tahakkukLookup = new();

    private int? _fTahakkukId;
    private decimal? _fMin;
    private decimal? _fMax;
    private DateTime? _fTarih;

    private string _orderBy = "Id desc";
    private int _pageSize = 10;
    private int _pageNumber = 1;

    private int? _editId;
    private OdemeRow _form = new() { Tutar = 0m };

    protected override async Task OnInitializedAsync()
    {
        _db = Provider.Create<OdemeRow>();

        try
        {
            await LoadLookup();
            await Load();
        }
        catch (Exception ex)
        {
            _msg = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private async Task LoadLookup()
    {
        // SP yoksa burada patlar -> zaten sen biliyorsun
        _tahakkukLookup = await Provider.SetItems<TahakkukLookupRow>(SP_TLK);
    }

    // =========================================================
    // ✅ İstenen: GetItems()
    // =========================================================
    private async Task GetItems()
    {
        if (_db is null) return;

        _db.Parameters.PageNumber = _pageNumber;
        _db.Parameters.PageSize = _pageSize;
        _db.Parameters.OrderBy = _orderBy;

        var where = new Dictionary<string, string>();

        if (_fTahakkukId is > 0) where["TahakkukId"] = _fTahakkukId.Value.ToString();
        if (_fMin is not null) where["MinTutar"] = _fMin.Value.ToString(CultureInfo.InvariantCulture);
        if (_fMax is not null) where["MaxTutar"] = _fMax.Value.ToString(CultureInfo.InvariantCulture);
        if (_fTarih is not null) where["OdemeTarihi"] = _fTarih.Value.ToString("yyyy-MM-dd");

        _db.Parameters.Where = where.Count == 0 ? null : where;

        await Provider.Execute(_db, SP_LIST, isPagination: true);

        // güvenli sayfa düzeltme
        if (_db.Parameters.TotalPageCount <= 0) _db.Parameters.TotalPageCount = 1;
        if (_db.Parameters.PageNumber < 1) _db.Parameters.PageNumber = 1;
        if (_db.Parameters.PageNumber > _db.Parameters.TotalPageCount)
            _db.Parameters.PageNumber = _db.Parameters.TotalPageCount;

        _pageNumber = _db.Parameters.PageNumber;
        _msg = _db.Message ?? _msg;
    }

    // =========================================================
    // ✅ İstenen: Load()
    // =========================================================
    private Task Load() => GetItems();

    // =========================================================
    // ✅ İstenen: OnChange_Filter()
    // =========================================================
    private async Task OnChange_Filter()
    {
        _pageNumber = 1;
        await GetItems();
    }

    // =========================================================
    // ✅ İstenen: OnChange_OrderBy()
    // =========================================================
    private async Task OnChange_OrderBy()
    {
        _pageNumber = 1;
        await GetItems();
    }

    // =========================================================
    // ✅ İstenen: OnChange_PageSize()
    // =========================================================
    private async Task OnChange_PageSize()
    {
        if (_pageSize <= 0) _pageSize = 10;
        if (_pageSize > 200) _pageSize = 200;

        _pageNumber = 1;
        await GetItems();
    }

    // =========================================================
    // ✅ İstenen: OnChange_Filter_Reset()
    // =========================================================
    private async Task OnChange_Filter_Reset()
    {
        _fTahakkukId = null;
        _fMin = null;
        _fMax = null;
        _fTarih = null;

        _orderBy = "Id desc";
        _pageSize = 10;
        _pageNumber = 1;

        OnClick_Cancel();
        await GetItems();
    }

    // =========================================================
    // ✅ İstenen: OnChange_PageNumber()
    // (dropdown)
    // =========================================================
    private async Task OnChange_PageNumber()
    {
        var max = _db?.Parameters.TotalPageCount ?? 1;
        if (max < 1) max = 1;

        if (_pageNumber < 1) _pageNumber = 1;
        if (_pageNumber > max) _pageNumber = max;

        await GetItems();
    }

    // =========================================================
    // yardımcı: butonla sayfa
    // =========================================================
    private async Task OnClick_PageNumber(string action)
    {
        if (_db is null) return;

        action = (action ?? "").Trim().ToLowerInvariant();

        if (action == "first") _pageNumber = 1;
        else if (action == "prev" && _pageNumber > 1) _pageNumber--;
        else if (action == "next" && _pageNumber < _db.Parameters.TotalPageCount) _pageNumber++;
        else if (action == "last") _pageNumber = _db.Parameters.TotalPageCount;

        await GetItems();
    }

    private void StartEdit(OdemeRow o)
    {
        _editId = o.Id;
        _form = new OdemeRow
            {
                Id = o.Id,
                TahakkukId = o.TahakkukId,
                Tutar = o.Tutar,
                OdemeTarihi = o.OdemeTarihi
            };
        _msg = null;
    }

    // =========================================================
    // ✅ İstenen: OnClick_Cancel()
    // =========================================================
    private void OnClick_Cancel()
    {
        _editId = null;
        _form = new OdemeRow { Tutar = 0m };
        _msg = null;
    }

    // =========================================================
    // ✅ İstenen: OnClick_Save()
    // =========================================================
    private Task OnClick_Save() => OnClick_Operation();

    // =========================================================
    // ✅ İstenen: OnClick_Operation()
    // =========================================================
    private async Task OnClick_Operation()
    {
        if (_form.TahakkukId <= 0) { await JS.InvokeVoidAsync("alert", "Tahakkuk seç."); return; }
        if (_form.Tutar < 0) { await JS.InvokeVoidAsync("alert", "Tutar negatif olamaz."); return; }

        var op = _editId is null ? "add" : "update";

        var payload = new
        {
            Id = _editId ?? 0,
            TahakkukId = _form.TahakkukId,
            Tutar = _form.Tutar,
            OdemeTarihi = _form.OdemeTarihi?.ToString("yyyy-MM-dd")
        };

        var json = JsonSerializer.Serialize(payload);

        var r = await Provider.SetItems<MyDbModel_Result_KeyValue<string, bool>>(
            SP_AUR,
            ("operation", op),
            ("jsonvalues", json)
        );

        var one = r.FirstOrDefault();
        await JS.InvokeVoidAsync("alert", $"{one?.Key} : {one?.Value}");

        OnClick_Cancel();
        await GetItems();
    }

    private async Task Delete(int id)
    {
        var json = JsonSerializer.Serialize(new { Id = id });

        var r = await Provider.SetItems<MyDbModel_Result_KeyValue<string, bool>>(
            SP_AUR,
            ("operation", "remove"),
            ("jsonvalues", json)
        );

        var one = r.FirstOrDefault();
        await JS.InvokeVoidAsync("alert", $"{one?.Key} : {one?.Value}");

        if (_editId == id) OnClick_Cancel();
        await GetItems();
    }
}
