@page "/admin/odemeler"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

@using System.Globalization
@using System.Text.Json
@using SAT242516026.Models.MyDbModels
@inject IMyDbModel_Provider Provider
@inject IJSRuntime JS

<h3 class="mb-3">Admin - Ödemeler</h3>

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <div class="alert alert-info">@_msg</div>
}

<div class="card mb-3">
    <div class="card-header fw-bold">Filtre / Sıralama / Sayfalama</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">TahakkukId</label>
                <input type="number" class="form-control" @bind="_fTahakkukId" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Min Tutar</label>
                <input type="number" step="0.01" class="form-control" @bind="_fMin" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Max Tutar</label>
                <input type="number" step="0.01" class="form-control" @bind="_fMax" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Ödeme Tarihi</label>
                <input type="date" class="form-control" @bind="_fTarih" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Sırala</label>
                <select class="form-select" @bind="_orderBy">
                    <option value="Id desc">Id ↓</option>
                    <option value="Id asc">Id ↑</option>
                    <option value="Tutar desc">Tutar ↓</option>
                    <option value="Tutar asc">Tutar ↑</option>
                    <option value="OdemeTarihi desc">Tarih ↓</option>
                    <option value="OdemeTarihi asc">Tarih ↑</option>
                    <option value="TahakkukId desc">TahakkukId ↓</option>
                    <option value="TahakkukId asc">TahakkukId ↑</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Boyut</label>
                <select class="form-select" @bind="_pageSize">
                    @foreach (var ps in new[] { 5, 10, 20, 50, 100 })
                    {
                        <option value="@ps">@ps</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <button type="button" class="btn btn-primary w-100" @onclick="Apply">Uygula</button>
            </div>

            <div class="col-md-2">
                <button type="button" class="btn btn-outline-danger w-100" @onclick="Reset">Sıfırla</button>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="small text-muted">
                @($"{(_db?.Parameters.TotalRecordCount ?? 0)} kayıt | Sayfa: {_pageNumber}/{_db?.Parameters.TotalPageCount ?? 1}")
            </div>

            <div class="btn-group">
                <button type="button" class="btn btn-outline-secondary" @onclick="First" disabled="@(_pageNumber<=1)">&lt;&lt;</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Prev" disabled="@(_pageNumber<=1)">&lt;</button>
                <button type="button" class="btn btn-outline-secondary" disabled>@_pageNumber / @(_db?.Parameters.TotalPageCount ?? 1)</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Next" disabled="@(_db is null || _pageNumber>=_db.Parameters.TotalPageCount)">&gt;</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Last" disabled="@(_db is null || _pageNumber>=_db.Parameters.TotalPageCount)">&gt;&gt;</button>
            </div>
        </div>
    </div>
</div>

<div class="card mb-5">
    <div class="card-header fw-bold">Ödeme (Ekle / Güncelle)</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label">Tahakkuk*</label>
                <select class="form-select" @bind="_form.TahakkukId">
                    <option value="0">Seç...</option>
                    @foreach (var t in _tahakkukLookup)
                    {
                        <option value="@t.Id">#@t.Id - @t.Tutar</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Tutar*</label>
                <input type="number" step="0.01" class="form-control" @bind="_form.Tutar" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Ödeme Tarihi</label>
                <input type="date" class="form-control" @bind="_form.OdemeTarihi" />
            </div>

            <div class="col-md-2">
                <button type="button" class="btn btn-success w-100" @onclick="Save">
                    @(_editId is null ? "Ekle" : "Güncelle")
                </button>

                @if (_editId is not null)
                {
                    <button type="button" class="btn btn-outline-secondary w-100 mt-2" @onclick="Cancel">İptal</button>
                }
            </div>
        </div>

        <hr />

        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:80px;">Id</th>
                        <th style="width:120px;">TahakkukId</th>
                        <th>Tutar</th>
                        <th>Ödeme Tarihi</th>
                        <th style="width:190px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if ((_db?.Items?.Count ?? 0) > 0)
                    {
                        @foreach (var o in _db!.Items!)
                        {
                            <tr>
                                <td>@o.Id</td>
                                <td>@o.TahakkukId</td>
                                <td>@o.Tutar</td>
                                <td>@(o.OdemeTarihi?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary me-2" @onclick="() => StartEdit(o)">Güncelle</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => Delete(o.Id)">Sil</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center text-muted py-3">Henüz ödeme yok.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private const string SP_LIST = "Sp_Odemeler";
    private const string SP_AUR = "sp_Odeme_Add_Update_Remove";
    private const string SP_TLK = "Sp_TahakkukLookup";

    private string? _msg;

    public class OdemeRow
    {
        public int Id { get; set; }
        public int TahakkukId { get; set; }
        public decimal Tutar { get; set; }
        public DateTime? OdemeTarihi { get; set; }
    }

    public class TahakkukLookupRow
    {
        public int Id { get; set; }
        public decimal Tutar { get; set; }
    }

    private IMyDbModel<OdemeRow>? _db;
    private List<TahakkukLookupRow> _tahakkukLookup = new();

    private int? _fTahakkukId;
    private decimal? _fMin;
    private decimal? _fMax;
    private DateTime? _fTarih;

    private string _orderBy = "Id desc";
    private int _pageSize = 10;
    private int _pageNumber = 1;

    private int? _editId;
    private OdemeRow _form = new() { Tutar = 0m };

    protected override async Task OnInitializedAsync()
    {
        _db = Provider.Create<OdemeRow>();

        try
        {
            await LoadLookup(); // <-- burada Sp_TahakkukLookup lazım
            await Load();
        }
        catch (Exception ex)
        {
            _msg = ex.InnerException?.Message ?? ex.Message;
        }
    }

    private async Task LoadLookup()
    {
        // Eğer SP yoksa burada patlar
        _tahakkukLookup = await Provider.SetItems<TahakkukLookupRow>(SP_TLK);
    }

    private async Task Load()
    {
        if (_db is null) return;

        _db.Parameters.PageNumber = _pageNumber;
        _db.Parameters.PageSize = _pageSize;
        _db.Parameters.OrderBy = _orderBy;

        var where = new Dictionary<string, string>();

        if (_fTahakkukId is > 0) where["TahakkukId"] = _fTahakkukId.Value.ToString();
        if (_fMin is not null) where["MinTutar"] = _fMin.Value.ToString(CultureInfo.InvariantCulture);
        if (_fMax is not null) where["MaxTutar"] = _fMax.Value.ToString(CultureInfo.InvariantCulture);
        if (_fTarih is not null) where["OdemeTarihi"] = _fTarih.Value.ToString("yyyy-MM-dd");

        _db.Parameters.Where = where.Count == 0 ? null : where;

        await Provider.Execute(_db, SP_LIST, isPagination: true);

        _pageNumber = _db.Parameters.PageNumber;
        _msg = _db.Message ?? _msg;
    }

    private async Task Apply() { _pageNumber = 1; await Load(); }

    private async Task Reset()
    {
        _fTahakkukId = null;
        _fMin = null;
        _fMax = null;
        _fTarih = null;

        _orderBy = "Id desc";
        _pageSize = 10;
        _pageNumber = 1;

        Cancel();
        await Load();
    }

    private async Task First() { _pageNumber = 1; await Load(); }
    private async Task Prev() { if (_pageNumber > 1) _pageNumber--; await Load(); }
    private async Task Next()
    {
        if (_db is null) return;
        if (_pageNumber < _db.Parameters.TotalPageCount) _pageNumber++;
        await Load();
    }
    private async Task Last()
    {
        if (_db is null) return;
        _pageNumber = _db.Parameters.TotalPageCount;
        await Load();
    }

    private void StartEdit(OdemeRow o)
    {
        _editId = o.Id;
        _form = new OdemeRow { Id = o.Id, TahakkukId = o.TahakkukId, Tutar = o.Tutar, OdemeTarihi = o.OdemeTarihi };
        _msg = "Düzenleme modunda.";
    }

    private void Cancel()
    {
        _editId = null;
        _form = new OdemeRow { Tutar = 0m };
    }

    private async Task Save()
    {
        if (_form.TahakkukId <= 0) { await JS.InvokeVoidAsync("alert", "Tahakkuk seç."); return; }
        if (_form.Tutar < 0) { await JS.InvokeVoidAsync("alert", "Tutar negatif olamaz."); return; }

        var op = _editId is null ? "add" : "update";

        var payload = new
        {
            Id = _editId ?? 0,
            TahakkukId = _form.TahakkukId,
            Tutar = _form.Tutar,
            OdemeTarihi = _form.OdemeTarihi?.ToString("yyyy-MM-dd")
        };

        var json = JsonSerializer.Serialize(payload);

        var r = await Provider.SetItems<MyDbModel_Result_KeyValue<string, bool>>(
            SP_AUR,
            ("operation", op),
            ("jsonvalues", json)
        );

        var one = r.FirstOrDefault();
        await JS.InvokeVoidAsync("alert", $"{one?.Key} : {one?.Value}");

        Cancel();
        await Load();
    }

    private async Task Delete(int id)
    {
        var json = JsonSerializer.Serialize(new { Id = id });

        var r = await Provider.SetItems<MyDbModel_Result_KeyValue<string, bool>>(
            SP_AUR,
            ("operation", "remove"),
            ("jsonvalues", json)
        );

        var one = r.FirstOrDefault();
        await JS.InvokeVoidAsync("alert", $"{one?.Key} : {one?.Value}");

        if (_editId == id) Cancel();
        await Load();
    }
}
