@page "/logs-1"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject SAT242516026.Logging.LogService LogService

<h3 class="mb-3">Log İzleme Merkezi</h3>

@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="alert alert-warning">@Message</div>
}

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-sm btn-outline-secondary" @onclick="Reload" disabled="@IsLoading">
        @(IsLoading ? "Yükleniyor..." : "Yenile")
    </button>
</div>

<h4 class="text-primary">📄 Dosya Logları</h4>
<div class="table-responsive mb-4" style="max-height:420px; overflow:auto;">
    <table class="table table-sm table-bordered table-striped mb-0">
        <thead class="table-dark sticky-top">
            <tr>
                <th style="width:90px;">Source</th>
                <th style="width:190px;">Timestamp</th>
                <th style="width:120px;">Level</th>
                <th style="width:260px;">Category</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>
            @if (fileLogs.Count == 0)
            {
                <tr><td colspan="5" class="text-center py-3">Dosya logu yok.</td></tr>
            }
            else
            {
                @foreach (var log in fileLogs)
                {
                    <tr>
                        <td>@log.Source</td>
                        <td>@log.Timestamp</td>
                        <td>@log.Level</td>
                        <td>@log.Category</td>
                        <td class="text-break">@log.Message</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<h4 class="text-success">🗄️ Veritabanı Logları</h4>
<div class="table-responsive" style="max-height:420px; overflow:auto;">
    <table class="table table-sm table-bordered table-striped mb-0">
        <thead class="table-dark sticky-top">
            <tr>
                <th style="width:90px;">Source</th>
                <th style="width:190px;">Timestamp</th>
                <th style="width:120px;">Level</th>
                <th style="width:260px;">Category</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>
            @if (dbLogs.Count == 0)
            {
                <tr><td colspan="5" class="text-center py-3">DB logu yok.</td></tr>
            }
            else
            {
                @foreach (var log in dbLogs)
                {
                    <tr>
                        <td>@log.Source</td>
                        <td>@log.Timestamp</td>
                        <td>@log.Level</td>
                        <td>@log.Category</td>
                        <td class="text-break">@log.Message</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private List<SAT242516026.Logging.LogEntry> fileLogs = new();
    private List<SAT242516026.Logging.LogEntry> dbLogs = new();

    private bool IsLoading;
    private string? Message;

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    private async Task Reload()
    {
        if (IsLoading) return;

        IsLoading = true;
        Message = null;

        try
        {
            fileLogs = await LogService.GetFileLogsAsync();
            dbLogs = await LogService.GetDbLogsAsync();
        }
        catch (Exception ex)
        {
            Message = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }
}

