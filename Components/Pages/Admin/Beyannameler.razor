@page "/admin/beyannameler"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

@using System.Text.Json
@using SAT242516026.Models.MyDbModels
@inject IMyDbModel_Provider Provider

<h3 class="mb-3">Admin - Beyannameler & Tipler</h3>

@if (!string.IsNullOrWhiteSpace(_msg))
{
    <div class="alert alert-warning">@_msg</div>
}

<!-- =========================================================
     1) BEYANNAME TİPLERİ (CRUD + F/S/P)
========================================================== -->
<div class="card mb-4">
    <div class="card-header fw-bold">Beyanname Tipleri</div>
    <div class="card-body">

        <div class="row g-2 align-items-end mb-3">
            <div class="col-md-3">
                <label class="form-label">Ad (Filtre)</label>
                <input class="form-control" @bind="_tip_fAd" @bind:event="oninput" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Sırala</label>
                <select class="form-select" @bind="_tip_orderBy">
                    <option value="Id desc">Id ↓</option>
                    <option value="Id asc">Id ↑</option>
                    <option value="Ad asc">Ad ↑</option>
                    <option value="Ad desc">Ad ↓</option>
                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">Boyut</label>
                <select class="form-select" @bind="_tip_pageSize">
                    @foreach (var ps in new[] { 5, 10, 20, 50 })
                    {
                        <option value="@ps">@ps</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <button class="btn btn-primary w-100" @onclick="TipApply">Uygula</button>
            </div>

            <div class="col-md-2">
                <button class="btn btn-outline-danger w-100" @onclick="TipReset">Sıfırla</button>
            </div>
        </div>

        <!-- Tip CRUD Form -->
        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Tip Adı*</label>
                <input class="form-control" @bind="_tip_form.Ad" @bind:event="oninput" />
            </div>

            <div class="col-md-3">
                <button class="btn btn-success w-100" @onclick="TipSave">
                    @(_tip_editId is null ? "Ekle" : "Güncelle")
                </button>
            </div>

            <div class="col-md-3">
                @if (_tip_editId is not null)
                {
                    <button class="btn btn-outline-secondary w-100" @onclick="TipCancel">İptal</button>
                }
            </div>
        </div>

        <hr />

        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="small text-muted">
                @_tipRangeText
            </div>

            <div class="btn-group">
                <button class="btn btn-outline-secondary" @onclick="TipFirst" disabled="@(_tip_pageNumber<=1)">&lt;&lt;</button>
                <button class="btn btn-outline-secondary" @onclick="TipPrev" disabled="@(_tip_pageNumber<=1)">&lt;</button>
                <button class="btn btn-outline-secondary" disabled>@_tip_pageNumber / @(_tipModel?.Parameters.TotalPageCount ?? 1)</button>
                <button class="btn btn-outline-secondary" @onclick="TipNext" disabled="@(_tipModel is null || _tip_pageNumber>=_tipModel.Parameters.TotalPageCount)">&gt;</button>
                <button class="btn btn-outline-secondary" @onclick="TipLast" disabled="@(_tipModel is null || _tip_pageNumber>=_tipModel.Parameters.TotalPageCount)">&gt;&gt;</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr>
                        <th style="width:90px;">Id</th>
                        <th>Ad</th>
                        <th style="width:180px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_tipModel?.Items?.Count > 0)
                    {
                        @foreach (var t in _tipModel.Items)
                        {
                            <tr>
                                <td>@t.Id</td>
                                <td>@t.Ad</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => TipStartEdit(t)">Güncelle</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => TipDelete(t.Id)">Sil</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="3" class="text-center text-muted py-3">Kayıt yok.</td></tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

<!-- =========================================================
     2) BEYANNAMELER (CRUD + F/S/P)
========================================================== -->
<div class="card mb-3">
    <div class="card-header fw-bold">Beyannameler</div>
    <div class="card-body">

        <!-- Filtre / Sıralama / Sayfalama -->
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">KullaniciId</label>
                <input class="form-control" type="number" @bind="_fKullaniciId" />
            </div>

            <div class="col-md-2">
                <label class="form-label">MukellefId</label>
                <input class="form-control" type="number" @bind="_fMukellefId" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Yıl</label>
                <input class="form-control" type="number" @bind="_fYil" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Durum</label>
                <input class="form-control" @bind="_fDurum" @bind:event="oninput" placeholder="Taslak / Odendi" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Sırala</label>
                <select class="form-select" @bind="_orderBy">
                    <option value="Id desc">Id ↓</option>
                    <option value="Id asc">Id ↑</option>
                    <option value="Yil desc">Yıl ↓</option>
                    <option value="Yil asc">Yıl ↑</option>
                    <option value="MukellefId asc">MukellefId ↑</option>
                    <option value="MukellefId desc">MukellefId ↓</option>
                    <option value="BeyannameTipiId asc">TipId ↑</option>
                    <option value="BeyannameTipiId desc">TipId ↓</option>
                </select>
            </div>

            <div class="col-md-1">
                <label class="form-label">Boyut</label>
                <select class="form-select" @bind="_pageSize">
                    @foreach (var ps in new[] { 5, 10, 20, 50 })
                    {
                        <option value="@ps">@ps</option>
                    }
                </select>
            </div>

            <div class="col-md-1">
                <button class="btn btn-primary w-100" @onclick="Apply">Uygula</button>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="small text-muted">
                @_beyanRangeText
            </div>

            <div class="btn-group">
                <button class="btn btn-outline-secondary" @onclick="First" disabled="@(_pageNumber<=1)">&lt;&lt;</button>
                <button class="btn btn-outline-secondary" @onclick="Prev" disabled="@(_pageNumber<=1)">&lt;</button>
                <button class="btn btn-outline-secondary" disabled>@_pageNumber / @(_model?.Parameters.TotalPageCount ?? 1)</button>
                <button class="btn btn-outline-secondary" @onclick="Next" disabled="@(_model is null || _pageNumber>=_model.Parameters.TotalPageCount)">&gt;</button>
                <button class="btn btn-outline-secondary" @onclick="Last" disabled="@(_model is null || _pageNumber>=_model.Parameters.TotalPageCount)">&gt;&gt;</button>
            </div>

            <button class="btn btn-outline-danger" @onclick="Reset">Sıfırla</button>
        </div>

        <hr />

        <!-- Beyanname CRUD Form -->
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">MukellefId*</label>
                <input class="form-control" type="number" @bind="_form.MukellefId" />
            </div>

            <div class="col-md-2">
                <label class="form-label">TipId*</label>
                <input class="form-control" type="number" @bind="_form.BeyannameTipiId" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Yıl*</label>
                <input class="form-control" type="number" @bind="_form.Yil" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Dönem</label>
                <input class="form-control" @bind="_form.Donem" @bind:event="oninput" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Durum</label>
                <input class="form-control" @bind="_form.Durum" @bind:event="oninput" />
            </div>

            <div class="col-md-2">
                <button class="btn btn-success w-100" @onclick="SaveBeyanname">
                    @(_editId is null ? "Ekle" : "Güncelle")
                </button>

                @if (_editId is not null)
                {
                    <button class="btn btn-outline-secondary w-100 mt-2" @onclick="CancelEdit">İptal</button>
                }
            </div>
        </div>

        <hr />

        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>MukellefId</th>
                        <th>KullaniciId</th>
                        <th>TipId</th>
                        <th>Yıl</th>
                        <th>Dönem</th>
                        <th>Durum</th>
                        <th style="width:190px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (_model?.Items?.Count > 0)
                    {
                        @foreach (var x in _model.Items)
                        {
                            <tr>
                                <td>@x.Id</td>
                                <td>@x.MukellefId</td>
                                <td>@x.KullaniciId</td>
                                <td>@x.BeyannameTipiId</td>
                                <td>@x.Yil</td>
                                <td>@x.Donem</td>
                                <td>@x.Durum</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => StartEdit(x)">Güncelle</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteBeyanname(x.Id)">Sil</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="8" class="text-center text-muted py-3">Kayıt yok.</td></tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

@code {
    // =======================
    // SP İSİMLERİ
    // =======================
    private const string SP_BEYAN_LIST = "Sp_Beyannameler";
    private const string SP_BEYAN_AUR = "sp_Beyanname_Add_Update_Remove";

    private const string SP_TIP_LIST = "Sp_BeyannameTipleri";
    private const string SP_TIP_AUR = "sp_BeyannameTipi_Add_Update_Remove";

    string? _msg;

    // =======================
    // TIP MODEL + UI STATE
    // =======================
    public class TipRow
    {
        public int Id { get; set; }
        public string? Ad { get; set; }
    }

    IMyDbModel<TipRow>? _tipModel;
    string? _tip_fAd;
    string _tip_orderBy = "Id desc";
    int _tip_pageSize = 10;
    int _tip_pageNumber = 1;
    int? _tip_editId;
    TipRow _tip_form = new();

    string _tipRangeText = "0 - 0 / 0";

    // =======================
    // BEYAN MODEL + UI STATE
    // =======================
    public class BeyannameRow
    {
        public int Id { get; set; }
        public int MukellefId { get; set; }
        public int KullaniciId { get; set; }
        public int BeyannameTipiId { get; set; }
        public int Yil { get; set; }
        public string? Donem { get; set; }
        public string? Durum { get; set; }

        // Bu alanlar SP döndürse bile sorun olmaz; tabloda göstermiyoruz.
        public DateTime? GondermeTarihi { get; set; }
        public DateTime? SonGondermeTarihi { get; set; }
    }

    IMyDbModel<BeyannameRow>? _model;

    int? _fKullaniciId;
    int? _fMukellefId;
    int? _fYil;
    string? _fDurum;

    string _orderBy = "Id desc";
    int _pageSize = 10;
    int _pageNumber = 1;

    int? _editId;
    BeyannameRow _form = new() { Yil = DateTime.Now.Year, Durum = "Taslak" };

    string _beyanRangeText = "0 - 0 / 0";

    protected override async Task OnInitializedAsync()
    {
        _tipModel = Provider.Create<TipRow>();
        _model = Provider.Create<BeyannameRow>();

        await TipLoad();
        await Load();
    }

    // =======================
    // RANGE TEXT HELPERS
    // =======================
    static string BuildRangeText(int page, int size, int total)
    {
        if (total <= 0) return "0 - 0 / 0";
        if (size <= 0) size = 10;
        if (page <= 0) page = 1;

        var start = (page - 1) * size + 1;
        var end = Math.Min(total, page * size);
        return $"{start} - {end} / {total}";
    }

    // =======================
    // TIP LIST LOAD
    // =======================
    private async Task TipLoad()
    {
        if (_tipModel is null) return;

        _tipModel.Parameters.PageNumber = _tip_pageNumber;
        _tipModel.Parameters.PageSize = _tip_pageSize;
        _tipModel.Parameters.OrderBy = _tip_orderBy;

        var where = new Dictionary<string, string>();
        if (!string.IsNullOrWhiteSpace(_tip_fAd))
            where["Ad"] = _tip_fAd.Trim();

        _tipModel.Parameters.Where = where.Count == 0 ? null : where;

        await Provider.Execute(_tipModel, SP_TIP_LIST, isPagination: true);

        if (_tipModel.Parameters.TotalPageCount <= 0) _tipModel.Parameters.TotalPageCount = 1;
        if (_tipModel.Parameters.PageNumber < 1) _tipModel.Parameters.PageNumber = 1;
        if (_tipModel.Parameters.PageNumber > _tipModel.Parameters.TotalPageCount)
            _tipModel.Parameters.PageNumber = _tipModel.Parameters.TotalPageCount;

        _tip_pageNumber = _tipModel.Parameters.PageNumber;
        _tipRangeText = BuildRangeText(_tip_pageNumber, _tip_pageSize, _tipModel.Parameters.TotalRecordCount);

        _msg = _tipModel.Message ?? _msg;
    }

    private async Task TipApply()
    {
        _tip_pageNumber = 1;
        await TipLoad();
    }

    private async Task TipReset()
    {
        _tip_fAd = null;
        _tip_orderBy = "Id desc";
        _tip_pageSize = 10;
        _tip_pageNumber = 1;
        TipCancel();
        await TipLoad();
    }

    private async Task TipFirst() { _tip_pageNumber = 1; await TipLoad(); }
    private async Task TipPrev() { if (_tip_pageNumber > 1) _tip_pageNumber--; await TipLoad(); }
    private async Task TipNext()
    {
        if (_tipModel is null) return;
        if (_tip_pageNumber < _tipModel.Parameters.TotalPageCount) _tip_pageNumber++;
        await TipLoad();
    }
    private async Task TipLast()
    {
        if (_tipModel is null) return;
        _tip_pageNumber = _tipModel.Parameters.TotalPageCount;
        await TipLoad();
    }

    private void TipStartEdit(TipRow t)
    {
        _tip_editId = t.Id;
        _tip_form = new TipRow { Id = t.Id, Ad = t.Ad };
        _msg = null;
    }

    private void TipCancel()
    {
        _tip_editId = null;
        _tip_form = new TipRow();
        _msg = null;
    }

    private async Task TipSave()
    {
        if (string.IsNullOrWhiteSpace(_tip_form.Ad))
        {
            _msg = "Tip adı boş olamaz.";
            return;
        }

        var op = _tip_editId is null ? "add" : "update";

        var payload = new
        {
            Id = _tip_editId ?? 0,
            Ad = _tip_form.Ad!.Trim()
        };

        var json = JsonSerializer.Serialize(payload);

        try
        {
            var r = await Provider.SetItems<MyDbModel_Result_KeyValue<string, bool>>(
                SP_TIP_AUR,
                ("operation", op),
                ("jsonvalues", json)
            );

            var one = r.FirstOrDefault();
            _msg = one is null ? "İşlem sonucu gelmedi." : one.Key;
        }
        catch (Exception ex)
        {
            _msg = ex.InnerException?.Message ?? ex.Message;
        }

        TipCancel();
        await TipLoad();
    }

    private async Task TipDelete(int id)
    {
        var json = JsonSerializer.Serialize(new { Id = id });

        try
        {
            var r = await Provider.SetItems<MyDbModel_Result_KeyValue<string, bool>>(
                SP_TIP_AUR,
                ("operation", "remove"),
                ("jsonvalues", json)
            );

            var one = r.FirstOrDefault();
            _msg = one is null ? "İşlem sonucu gelmedi." : one.Key;
        }
        catch (Exception ex)
        {
            _msg = ex.InnerException?.Message ?? ex.Message;
        }

        if (_tip_editId == id) TipCancel();
        await TipLoad();
    }

    // =======================
    // BEYAN LIST LOAD
    // =======================
    private async Task Load()
    {
        if (_model is null) return;

        _model.Parameters.PageNumber = _pageNumber;
        _model.Parameters.PageSize = _pageSize;
        _model.Parameters.OrderBy = _orderBy;

        var where = new Dictionary<string, string>();

        if (_fKullaniciId is > 0) where["KullaniciId"] = _fKullaniciId.Value.ToString();
        if (_fMukellefId is > 0) where["MukellefId"] = _fMukellefId.Value.ToString();
        if (_fYil is > 0) where["Yil"] = _fYil.Value.ToString();
        if (!string.IsNullOrWhiteSpace(_fDurum)) where["Durum"] = _fDurum.Trim();

        _model.Parameters.Where = where.Count == 0 ? null : where;

        await Provider.Execute(_model, SP_BEYAN_LIST, isPagination: true);

        if (_model.Parameters.TotalPageCount <= 0) _model.Parameters.TotalPageCount = 1;
        if (_model.Parameters.PageNumber < 1) _model.Parameters.PageNumber = 1;
        if (_model.Parameters.PageNumber > _model.Parameters.TotalPageCount)
            _model.Parameters.PageNumber = _model.Parameters.TotalPageCount;

        _pageNumber = _model.Parameters.PageNumber;
        _beyanRangeText = BuildRangeText(_pageNumber, _pageSize, _model.Parameters.TotalRecordCount);

        _msg = _model.Message ?? _msg;
    }

    private async Task Apply()
    {
        _pageNumber = 1;
        await Load();
    }

    private async Task Reset()
    {
        _fKullaniciId = null;
        _fMukellefId = null;
        _fYil = null;
        _fDurum = null;

        _orderBy = "Id desc";
        _pageSize = 10;
        _pageNumber = 1;

        CancelEdit();
        await Load();
    }

    private async Task First() { _pageNumber = 1; await Load(); }
    private async Task Prev() { if (_pageNumber > 1) _pageNumber--; await Load(); }
    private async Task Next()
    {
        if (_model is null) return;
        if (_pageNumber < _model.Parameters.TotalPageCount) _pageNumber++;
        await Load();
    }
    private async Task Last()
    {
        if (_model is null) return;
        _pageNumber = _model.Parameters.TotalPageCount;
        await Load();
    }

    private void StartEdit(BeyannameRow x)
    {
        _editId = x.Id;
        _form = new BeyannameRow
            {
                Id = x.Id,
                MukellefId = x.MukellefId,
                KullaniciId = x.KullaniciId,
                BeyannameTipiId = x.BeyannameTipiId,
                Yil = x.Yil,
                Donem = x.Donem,
                Durum = x.Durum,
                GondermeTarihi = x.GondermeTarihi,
                SonGondermeTarihi = x.SonGondermeTarihi
            };
        _msg = null;
    }

    private void CancelEdit()
    {
        _editId = null;
        _form = new BeyannameRow { Yil = DateTime.Now.Year, Durum = "Taslak" };
        _msg = null;
    }

    private async Task SaveBeyanname()
    {
        // Validasyonları sayfa içi mesajla veriyoruz
        if (_form.MukellefId <= 0) { _msg = "MukellefId gir."; return; }
        if (_form.BeyannameTipiId <= 0) { _msg = "BeyannameTipiId gir."; return; }
        if (_form.Yil <= 0) { _msg = "Yıl gir."; return; }

        var op = _editId is null ? "add" : "update";

        // Update için Id json içinde olacak (hocanın AUR mantığı)
        var payload = new
        {
            Id = _editId ?? 0,
            MukellefId = _form.MukellefId,
            BeyannameTipiId = _form.BeyannameTipiId,
            Yil = _form.Yil,
            Donem = _form.Donem,
            Durum = _form.Durum
            // tarihleri tabloya koymuyoruz; SP istiyorsa burada da gönderebilirsin
        };

        var json = JsonSerializer.Serialize(payload);

        try
        {
            var r = await Provider.SetItems<MyDbModel_Result_KeyValue<string, bool>>(
                SP_BEYAN_AUR,
                ("operation", op),
                ("jsonvalues", json)
            );

            var one = r.FirstOrDefault();
            _msg = one is null ? "İşlem sonucu gelmedi." : one.Key;
        }
        catch (Exception ex)
        {
            _msg = ex.InnerException?.Message ?? ex.Message;
        }

        CancelEdit();
        await Load();
    }

    private async Task DeleteBeyanname(int id)
    {
        var json = JsonSerializer.Serialize(new { Id = id });

        try
        {
            var r = await Provider.SetItems<MyDbModel_Result_KeyValue<string, bool>>(
                SP_BEYAN_AUR,
                ("operation", "remove"),
                ("jsonvalues", json)
            );

            var one = r.FirstOrDefault();
            _msg = one is null ? "İşlem sonucu gelmedi." : one.Key;
        }
        catch (Exception ex)
        {
            _msg = ex.InnerException?.Message ?? ex.Message;
        }

        if (_editId == id) CancelEdit();
        await Load();
    }
}
