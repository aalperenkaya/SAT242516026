@page "/admin/tahakkuklar"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

@using SAT242516026.Data
@using SAT242516026.Models.Enums
@using SAT242516026.Models.MyDbModels
@using System.Globalization
@using System.Text.Json

@inject IMyDbModel<Tahakkuk> _db
@inject IMyDbModel_Provider _provider
@inject IJSRuntime JS

<h3 class="mb-3">Admin - Tahakkuklar</h3>
<hr />

@if (!string.IsNullOrWhiteSpace(_db.Message))
{
    <div class="alert alert-info">@_db.Message</div>
}

<div class="card mb-3">
    <div class="card-header fw-bold">Filtre / Sıralama / Sayfalama</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">

            <div class="col-md-2">
                <label class="form-label">BeyannameId</label>
                <input type="number" class="form-control"
                       @bind="F_BeyannameId"
                       @bind:event="oninput"
                       @bind:after="OnChange_Filter" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Min Tutar</label>
                <input type="number" step="0.01" class="form-control"
                       @bind="F_MinTutar"
                       @bind:event="oninput"
                       @bind:after="OnChange_Filter" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Max Tutar</label>
                <input type="number" step="0.01" class="form-control"
                       @bind="F_MaxTutar"
                       @bind:event="oninput"
                       @bind:after="OnChange_Filter" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Tarih</label>
                <input type="date" class="form-control"
                       @bind="F_Tarih"
                       @bind:after="OnChange_Filter" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Sırala</label>
                <select class="form-select"
                        @bind="OrderBy"
                        @bind:after="OnChange_OrderBy">
                    @foreach (var ob in OrderByItems)
                    {
                        <option value="@ob.Value">@ob.Key</option>
                    }
                </select>
            </div>

            <div class="col-md-1">
                <label class="form-label">Boyut</label>
                <select class="form-select"
                        @bind="PageSize"
                        @bind:after="OnChange_PageSize">
                    @foreach (var ps in new[] { 5, 10, 20, 50, 100 })
                    {
                        <option value="@ps">@ps</option>
                    }
                </select>
            </div>

            <div class="col-md-1">
                <button type="button" class="btn btn-primary w-100" @onclick="Load">Uygula</button>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="small text-muted">
                @($"{(_db.Parameters.TotalRecordCount == 0 ? 0 : (_db.Parameters.PageNumber - 1) * _db.Parameters.PageSize + 1)} - {Math.Min(_db.Parameters.TotalRecordCount, _db.Parameters.PageNumber * _db.Parameters.PageSize)} / {_db.Parameters.TotalRecordCount}")
            </div>

            <div class="d-flex gap-2 align-items-center">
                <div class="small text-muted">Sayfa</div>
                <select class="form-select form-select-sm" style="width:120px;"
                        @bind="_db.Parameters.PageNumber"
                        @bind:after="OnChange_PageNumber">
                    @{
                        var total = _db.Parameters.TotalPageCount;
                        if (total < 1) total = 1;
                        for (int p = 1; p <= total; p++)
                        {
                            <option value="@p">@p</option>
                        }
                    }
                </select>

                <div class="btn-group">
                    <button type="button" class="btn btn-outline-secondary"
                            @onclick='() => OnClick_PageNumber("first")'
                            disabled="@(_db.Parameters.PageNumber<=1)">
                        &lt;&lt;
                    </button>

                    <button type="button" class="btn btn-outline-secondary"
                            @onclick='() => OnClick_PageNumber("prev")'
                            disabled="@(_db.Parameters.PageNumber<=1)">
                        &lt;
                    </button>

                    <button type="button" class="btn btn-outline-secondary" disabled>
                        @_db.Parameters.PageNumber / @_db.Parameters.TotalPageCount
                    </button>

                    <button type="button" class="btn btn-outline-secondary"
                            @onclick='() => OnClick_PageNumber("next")'
                            disabled="@(_db.Parameters.PageNumber>=_db.Parameters.TotalPageCount)">
                        &gt;
                    </button>

                    <button type="button" class="btn btn-outline-secondary"
                            @onclick='() => OnClick_PageNumber("last")'
                            disabled="@(_db.Parameters.PageNumber>=_db.Parameters.TotalPageCount)">
                        &gt;&gt;
                    </button>
                </div>
            </div>

            <button type="button" class="btn btn-outline-danger" @onclick="OnChange_Filter_Reset">Sıfırla</button>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-bold">Tahakkuk (Ekle / Güncelle)</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">

            <div class="col-md-5">
                <label class="form-label">BeyannameId*</label>
                <input type="number" class="form-control" @bind="_model.BeyannameId" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Tutar*</label>
                <input type="number" step="0.01" class="form-control" @bind="_model.Tutar" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Tarih</label>
                <input type="date" class="form-control" @bind="_model.Tarih" />
            </div>

            <div class="col-md-2">
                <button type="button" class="btn btn-success w-100" @onclick="OnClick_Save">
                    @(_operation == Operations.Add ? "Ekle" : "Güncelle")
                </button>

                @if (_operation != Operations.Add)
                {
                    <button type="button" class="btn btn-outline-secondary w-100 mt-2" @onclick="OnClick_Cancel">İptal</button>
                }
            </div>
        </div>

        <hr />

        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:80px;">Id</th>
                        <th style="width:120px;">BeyannameId</th>
                        <th>Tutar</th>
                        <th>Tarih</th>
                        <th style="width:190px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _db.Items)
                    {
                        <tr>
                            <td>@t.Id</td>
                            <td>@t.BeyannameId</td>
                            <td>@t.Tutar</td>
                            <td>@(t.Tarih?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary me-2"
                                        @onclick="() => StartEdit(t)">
                                    Güncelle
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        @onclick="() => Delete(t.Id)">
                                    Sil
                                </button>
                            </td>
                        </tr>
                    }

                    @if (_db.Items.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted py-3">Kayıt yok.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private readonly string _spList = "Sp_Tahakkuklar";
    private readonly string _spAur = "sp_Tahakkuk_Add_Update_Remove";

    private Operations _operation = Operations.Add;
    private Tahakkuk _model = new() { Tutar = 0m };

    int? F_BeyannameId;
    decimal? F_MinTutar;
    decimal? F_MaxTutar;
    DateTime? F_Tarih;

    string OrderBy = "Id desc";
    int PageSize = 10;

    Dictionary<string, string> OrderByItems = new()
    {
        { "Id ↓", "Id desc" },
        { "Id ↑", "Id asc" },
        { "Tutar ↓", "Tutar desc" },
        { "Tutar ↑", "Tutar asc" },
        { "Tarih ↓", "Tarih desc" },
        { "Tarih ↑", "Tarih asc" },
        { "BeyannameId ↑", "BeyannameId asc" },
        { "BeyannameId ↓", "BeyannameId desc" },
    };

    protected override async Task OnInitializedAsync()
    {
        _db.Parameters.PageNumber = 1;
        _db.Parameters.PageSize = PageSize;
        _db.Parameters.OrderBy = OrderBy;

        await GetItems();
    }

    // =========================================================
    // ✅ İstenen: GetItems()
    // =========================================================
    private async Task GetItems()
    {
        _db.Parameters.Where = new Dictionary<string, string>();

        if (F_BeyannameId is > 0)
            _db.Parameters.Where["BeyannameId"] = F_BeyannameId.Value.ToString();

        if (F_MinTutar is not null)
            _db.Parameters.Where["MinTutar"] = F_MinTutar.Value.ToString(CultureInfo.InvariantCulture);

        if (F_MaxTutar is not null)
            _db.Parameters.Where["MaxTutar"] = F_MaxTutar.Value.ToString(CultureInfo.InvariantCulture);

        if (F_Tarih is not null)
            _db.Parameters.Where["Tarih"] = F_Tarih.Value.ToString("yyyy-MM-dd");

        // boşsa null yap (hocanın tarzı)
        if (_db.Parameters.Where.Count == 0)
            _db.Parameters.Where = null;

        _db.Parameters.OrderBy = OrderBy;
        _db.Parameters.PageSize = PageSize;

        await _provider.Execute(_db, _spList, isPagination: true);

        // güvenli sayfa düzeltme
        if (_db.Parameters.TotalPageCount <= 0) _db.Parameters.TotalPageCount = 1;
        if (_db.Parameters.PageNumber < 1) _db.Parameters.PageNumber = 1;
        if (_db.Parameters.PageNumber > _db.Parameters.TotalPageCount)
            _db.Parameters.PageNumber = _db.Parameters.TotalPageCount;
    }

    // =========================================================
    // ✅ İstenen: Load()
    // =========================================================
    private Task Load() => GetItems();

    // =========================================================
    // ✅ İstenen: OnChange_Filter()
    // =========================================================
    private async Task OnChange_Filter()
    {
        _db.Parameters.PageNumber = 1;
        await GetItems();
    }

    // =========================================================
    // ✅ İstenen: OnChange_OrderBy()
    // =========================================================
    private async Task OnChange_OrderBy()
    {
        _db.Parameters.PageNumber = 1;
        await GetItems();
    }

    // =========================================================
    // ✅ İstenen: OnChange_PageSize()
    // =========================================================
    private async Task OnChange_PageSize()
    {
        if (PageSize <= 0) PageSize = 10;
        if (PageSize > 200) PageSize = 200;

        _db.Parameters.PageSize = PageSize;
        _db.Parameters.PageNumber = 1;

        await GetItems();
    }

    // =========================================================
    // ✅ İstenen: OnChange_Filter_Reset()
    // =========================================================
    private async Task OnChange_Filter_Reset()
    {
        F_BeyannameId = null;
        F_MinTutar = null;
        F_MaxTutar = null;
        F_Tarih = null;

        OrderBy = "Id desc";
        PageSize = 10;

        _db.Parameters.PageNumber = 1;
        _db.Parameters.PageSize = PageSize;
        _db.Parameters.OrderBy = OrderBy;

        await GetItems();
    }

    // =========================================================
    // ✅ İstenen: OnChange_PageNumber()
    // (dropdown’dan geldiğinde)
    // =========================================================
    private async Task OnChange_PageNumber()
    {
        var max = _db.Parameters.TotalPageCount;
        if (max < 1) max = 1;

        if (_db.Parameters.PageNumber < 1) _db.Parameters.PageNumber = 1;
        if (_db.Parameters.PageNumber > max) _db.Parameters.PageNumber = max;

        await GetItems();
    }

    // =========================================================
    // Yardımcı: butonla sayfa değişimi (first/prev/next/last)
    // =========================================================
    private async Task OnClick_PageNumber(string action)
    {
        action = (action ?? "").Trim().ToLowerInvariant();

        if (action == "first") _db.Parameters.PageNumber = 1;
        else if (action == "prev" && _db.Parameters.PageNumber > 1) _db.Parameters.PageNumber--;
        else if (action == "next" && _db.Parameters.PageNumber < _db.Parameters.TotalPageCount) _db.Parameters.PageNumber++;
        else if (action == "last") _db.Parameters.PageNumber = _db.Parameters.TotalPageCount;

        await GetItems();
    }

    // =========================================================
    // ✅ İstenen: OnClick_Cancel()
    // =========================================================
    private Task OnClick_Cancel()
    {
        _operation = Operations.Add;
        _model = new Tahakkuk { Tutar = 0m };
        return Task.CompletedTask;
    }

    // =========================================================
    // StartEdit (tabloda update butonu)
    // =========================================================
    private void StartEdit(Tahakkuk t)
    {
        _operation = Operations.Update;
        _model = new Tahakkuk
            {
                Id = t.Id,
                BeyannameId = t.BeyannameId,
                Tutar = t.Tutar,
                Tarih = t.Tarih
            };
    }

    // =========================================================
    // ✅ İstenen: OnClick_Save() -> Save düğmesi burayı çağırır
    // =========================================================
    private Task OnClick_Save() => OnClick_Operation();

    // =========================================================
    // ✅ İstenen: OnClick_Operation() -> add/update işlemi
    // =========================================================
    private async Task OnClick_Operation()
    {
        if (_model.BeyannameId <= 0)
        {
            await JS.InvokeVoidAsync("alert", "BeyannameId gir.");
            return;
        }

        if (_model.Tutar < 0)
        {
            await JS.InvokeVoidAsync("alert", "Tutar negatif olamaz.");
            return;
        }

        var json = JsonSerializer.Serialize(_model);
        var op = _operation == Operations.Add ? "add" : "update";

        var result = await _provider.SetItems<MyDbModel_Result_KeyValue<string, bool>>(
            _spAur,
            ("@operation", op),
            ("@jsonvalues", json)
        );

        var r = result.FirstOrDefault();
        await JS.InvokeVoidAsync("alert", $"{r?.Key} : {r?.Value}");

        await OnClick_Cancel();
        await GetItems();
    }

    private async Task Delete(int id)
    {
        var json = JsonSerializer.Serialize(new { Id = id });

        var result = await _provider.SetItems<MyDbModel_Result_KeyValue<string, bool>>(
            _spAur,
            ("@operation", "remove"),
            ("@jsonvalues", json)
        );

        var r = result.FirstOrDefault();
        await JS.InvokeVoidAsync("alert", $"{r?.Key} : {r?.Value}");

        if (_model.Id == id) await OnClick_Cancel();
        await GetItems();
    }
}
