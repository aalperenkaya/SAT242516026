@page "/admin/tahakkuklar"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

@using SAT242516026.Data
@using SAT242516026.Models.Enums
@using SAT242516026.Models.MyDbModels
@using System.Globalization
@using System.Text.Json

@inject IMyDbModel<Tahakkuk> _db
@inject IMyDbModel_Provider _provider
@inject IJSRuntime JS

<h3 class="mb-3">Admin - Tahakkuklar</h3>
<hr />

@if (!string.IsNullOrWhiteSpace(_db.Message))
{
    <div class="alert alert-info">@_db.Message</div>
}

<div class="card mb-3">
    <div class="card-header fw-bold">Filtre / Sıralama / Sayfalama</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">

            <div class="col-md-2">
                <label class="form-label">BeyannameId</label>
                <input type="number" class="form-control" @bind="F_BeyannameId" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Min Tutar</label>
                <input type="number" step="0.01" class="form-control" @bind="F_MinTutar" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Max Tutar</label>
                <input type="number" step="0.01" class="form-control" @bind="F_MaxTutar" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Tarih</label>
                <input type="date" class="form-control" @bind="F_Tarih" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Sırala</label>
                <select class="form-select" @bind="OrderBy">
                    @foreach (var ob in OrderByItems)
                    {
                        <option value="@ob.Value">@ob.Key</option>
                    }
                </select>
            </div>

            <div class="col-md-1">
                <label class="form-label">Boyut</label>
                <select class="form-select" @bind="PageSize">
                    @foreach (var ps in new[] { 5, 10, 20, 50, 100 })
                    {
                        <option value="@ps">@ps</option>
                    }
                </select>
            </div>

            <div class="col-md-1">
                <button type="button" class="btn btn-primary w-100" @onclick="ApplyQuery">Uygula</button>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="small text-muted">
                @($"{(_db.Parameters.TotalRecordCount == 0 ? 0 : (_db.Parameters.PageNumber - 1) * _db.Parameters.PageSize + 1)} - {Math.Min(_db.Parameters.TotalRecordCount, _db.Parameters.PageNumber * _db.Parameters.PageSize)} / {_db.Parameters.TotalRecordCount}")
            </div>

            <div class="btn-group">
                <button type="button" class="btn btn-outline-secondary" @onclick="FirstPage" disabled="@(_db.Parameters.PageNumber<=1)">&lt;&lt;</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="PrevPage" disabled="@(_db.Parameters.PageNumber<=1)">&lt;</button>
                <button type="button" class="btn btn-outline-secondary" disabled>
                    @_db.Parameters.PageNumber / @_db.Parameters.TotalPageCount
                </button>
                <button type="button" class="btn btn-outline-secondary" @onclick="NextPage" disabled="@(_db.Parameters.PageNumber>=_db.Parameters.TotalPageCount)">&gt;</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="LastPage" disabled="@(_db.Parameters.PageNumber>=_db.Parameters.TotalPageCount)">&gt;&gt;</button>
            </div>

            <button type="button" class="btn btn-outline-danger" @onclick="ResetQuery">Sıfırla</button>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-bold">Tahakkuk (Ekle / Güncelle)</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">

            <div class="col-md-5">
                <label class="form-label">BeyannameId*</label>
                <input type="number" class="form-control" @bind="_model.BeyannameId" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Tutar*</label>
                <input type="number" step="0.01" class="form-control" @bind="_model.Tutar" />
            </div>

            <div class="col-md-2">
                <label class="form-label">Tarih</label>
                <input type="date" class="form-control" @bind="_model.Tarih" />
            </div>

            <div class="col-md-2">
                <button type="button" class="btn btn-success w-100" @onclick="Save">
                    @(_operation == Operations.Add ? "Ekle" : "Güncelle")
                </button>

                @if (_operation != Operations.Add)
                {
                    <button type="button" class="btn btn-outline-secondary w-100 mt-2" @onclick="CancelEdit">İptal</button>
                }
            </div>
        </div>

        <hr />

        <div class="table-responsive">
            <table class="table table-sm table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:80px;">Id</th>
                        <th style="width:120px;">BeyannameId</th>
                        <th>Tutar</th>
                        <th>Tarih</th>
                        <th style="width:190px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in _db.Items)
                    {
                        <tr>
                            <td>@t.Id</td>
                            <td>@t.BeyannameId</td>
                            <td>@t.Tutar</td>
                            <td>@(t.Tarih?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary me-2"
                                        @onclick="() => StartEdit(t)">
                                    Güncelle
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        @onclick="() => Delete(t.Id)">
                                    Sil
                                </button>
                            </td>
                        </tr>
                    }

                    @if (_db.Items.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted py-3">Kayıt yok.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private readonly string _spList = "Sp_Tahakkuklar";
    private readonly string _spAur = "sp_Tahakkuk_Add_Update_Remove";

    private Operations _operation = Operations.Add;
    private Tahakkuk _model = new() { Tutar = 0m };

    int? F_BeyannameId;
    decimal? F_MinTutar;
    decimal? F_MaxTutar;
    DateTime? F_Tarih;

    string OrderBy = "Id desc";
    int PageSize = 10;

    Dictionary<string, string> OrderByItems = new()
    {
        { "Id ↓", "Id desc" },
        { "Id ↑", "Id asc" },
        { "Tutar ↓", "Tutar desc" },
        { "Tutar ↑", "Tutar asc" },
        { "Tarih ↓", "Tarih desc" },
        { "Tarih ↑", "Tarih asc" },
        { "BeyannameId ↑", "BeyannameId asc" },
        { "BeyannameId ↓", "BeyannameId desc" },
    };

    protected override async Task OnInitializedAsync()
    {
        _db.Parameters.PageNumber = 1;
        _db.Parameters.PageSize = PageSize;
        _db.Parameters.OrderBy = OrderBy;

        await Load();
    }

    private async Task Load()
    {
        _db.Parameters.Where = new Dictionary<string, string>();

        if (F_BeyannameId is not null && F_BeyannameId > 0)
            _db.Parameters.Where["BeyannameId"] = F_BeyannameId.Value.ToString();

        if (F_MinTutar is not null)
            _db.Parameters.Where["MinTutar"] = F_MinTutar.Value.ToString(CultureInfo.InvariantCulture);

        if (F_MaxTutar is not null)
            _db.Parameters.Where["MaxTutar"] = F_MaxTutar.Value.ToString(CultureInfo.InvariantCulture);

        if (F_Tarih is not null)
            _db.Parameters.Where["Tarih"] = F_Tarih.Value.ToString("yyyy-MM-dd");

        _db.Parameters.OrderBy = OrderBy;
        _db.Parameters.PageSize = PageSize;

        await _provider.Execute(_db, _spList, isPagination: true);
    }

    private async Task ApplyQuery()
    {
        _db.Parameters.PageNumber = 1;
        await Load();
    }

    private async Task ResetQuery()
    {
        F_BeyannameId = null;
        F_MinTutar = null;
        F_MaxTutar = null;
        F_Tarih = null;

        OrderBy = "Id desc";
        PageSize = 10;

        _db.Parameters.PageNumber = 1;
        await Load();
    }

    private async Task FirstPage() { _db.Parameters.PageNumber = 1; await Load(); }
    private async Task LastPage() { _db.Parameters.PageNumber = _db.Parameters.TotalPageCount; await Load(); }
    private async Task PrevPage() { if (_db.Parameters.PageNumber > 1) _db.Parameters.PageNumber--; await Load(); }
    private async Task NextPage() { if (_db.Parameters.PageNumber < _db.Parameters.TotalPageCount) _db.Parameters.PageNumber++; await Load(); }

    private void StartEdit(Tahakkuk t)
    {
        _operation = Operations.Update;
        _model = new Tahakkuk
            {
                Id = t.Id,
                BeyannameId = t.BeyannameId,
                Tutar = t.Tutar,
                Tarih = t.Tarih
            };
    }

    private void CancelEdit()
    {
        _operation = Operations.Add;
        _model = new Tahakkuk { Tutar = 0m };
    }

    private async Task Save()
    {
        if (_model.BeyannameId <= 0)
        {
            await JS.InvokeVoidAsync("alert", "BeyannameId gir.");
            return;
        }

        if (_model.Tutar < 0)
        {
            await JS.InvokeVoidAsync("alert", "Tutar negatif olamaz.");
            return;
        }

        var json = JsonSerializer.Serialize(_model);
        var op = _operation == Operations.Add ? "add" : "update";

        var result = await _provider.SetItems<MyDbModel_Result_KeyValue<string, bool>>(
            _spAur,
            ("@operation", op),
            ("@jsonvalues", json)
        );

        var r = result.FirstOrDefault();
        await JS.InvokeVoidAsync("alert", $"{r?.Key} : {r?.Value}");

        CancelEdit();
        await Load();
    }

    private async Task Delete(int id)
    {
        var json = JsonSerializer.Serialize(new { Id = id });

        var result = await _provider.SetItems<MyDbModel_Result_KeyValue<string, bool>>(
            _spAur,
            ("@operation", "remove"),
            ("@jsonvalues", json)
        );

        var r = result.FirstOrDefault();
        await JS.InvokeVoidAsync("alert", $"{r?.Key} : {r?.Value}");

        if (_model.Id == id) CancelEdit();
        await Load();
    }
}
